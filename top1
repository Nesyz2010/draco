repeat task.wait() until game:IsLoaded()
repeat task.wait() until game.Players.LocalPlayer

-- ================================
-- 📦 SERVICES & PLAYER
-- ================================
local Players = game:GetService("Players")
local plr = Players.LocalPlayer
local Rep = game:GetService("ReplicatedStorage")

-- ================================
-- 📌 FUNCTION CHECK RACE V1–V4
-- ================================
local function GetRaceStage()
    local v113 = Rep.Remotes.CommF_:InvokeServer("Wenlocktoad", "1") -- V3
    local v111 = Rep.Remotes.CommF_:InvokeServer("Alchemist", "1")   -- V2

    local race = plr.Data.Race.Value

    if plr.Character:FindFirstChild("RaceTransformed") then
        return race .. "-V4"
    end
    if v113 == -2 then
        return race .. "-V3"
    end
    if v111 == -2 then
        return race .. "-V2"
    end
    return race .. "-V1"
end

-- ================================
-- 📌 FUNCTION GET AWAKENED SKILLS
-- ================================
local function GetAwakened()
    local list = {}
    local data = Rep.Remotes.CommF_:InvokeServer("getAwakenedAbilities")

    if data then
        for _, v in pairs(data) do
            if v.Awakened then
                table.insert(list, v.Key)
            end
        end
    end

    return table.concat(list, ", ")
end

-- ================================
-- 📌 FUNCTION GET OWNED FIGHTING STYLE
-- ================================
local function GetFighting()
    local styles = {"Superhuman","ElectricClaw","DragonTalon","SharkmanKarate","DeathStep","Godhuman","SanguineArt"}
    local result = ""

    for _, s in pairs(styles) do
        local ok = Rep.Remotes.CommF_:InvokeServer("Buy" .. s, true)
        if ok == 1 then
            result = result .. s .. ", "
        end
    end

    return result
end

-- ================================
-- 📌 FUNCTION GET MATERIAL
-- ================================
local function GetMaterials()
    local inv = Rep.Remotes.CommF_:InvokeServer("getInventory")
    local text = ""

    for _, item in pairs(inv) do
        if item.Type == "Material" then
            if text ~= "" then text = text .. "\n" end
            text = text .. item.Name .. ": " .. item.Count
        end
    end

    return text
end

-- ================================
-- 📌 FUNCTION TRAIN SS LEFT
-- ================================
local function GetTrainLeft()
    local a, b = Rep.Remotes.CommF_:InvokeServer("UpgradeRace","Check")
    if a == 8 then
        return tostring(10 - b)
    else
        return "0"
    end
end

-- ================================
-- 📌 FUNCTION CHECK LEVER
-- ================================
local function CheckLever()
    return Rep.Remotes.CommF_:InvokeServer("CheckTempleDoor") and "YES" or "NO"
end

-- ================================
-- 📌 FUNCTION GEAR STATUS
-- ================================
local function GetGear()
    local A, B, C = Rep.Remotes.CommF_:InvokeServer("UpgradeRace","Check")

    if not plr.Character:FindFirstChild("RaceTransformed") then
        return "Not Transformed"
    end

    local Msg = {
        "Required Train More",
        C and ("Can Buy Gear With " .. C .. " Fragments") or "No Data",
        "Required Train More",
        C and ("Can Buy Gear With " .. C .. " Fragments") or "No Data",
        "Full Gear, Full Update!",
        B and ("Gear 3, Upgraded: " .. (B - 2) .. "/3") or "No Data",
        C and ("Can Buy Gear With " .. C .. " Fragments") or "No Data",
        B and ("Full Gear, Remaining: "..(10-B).."/5 Trains") or "No Data"
    }

    return Msg[A] or "Ready For Trial"
end

