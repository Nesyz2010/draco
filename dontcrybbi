-- DRACO TAB (AUTO DOJO QUEST FIX VĨNH VIỄN)
------------------------------------------------------------
local dojoPos = CFrame.new(5865.9468, 1208.5947, 872.6288)

local function ReadDojoState()
    local data = LP:FindFirstChild("Data")
    if not data then return nil end

    return data:FindFirstChild("Dojo") and data.Dojo:FindFirstChild("Quest") and data.Dojo.Quest.Value
end

local function DojoRemote(cmd)
    pcall(function()
        ReplicatedStorage.Modules.Net["RF/InteractDragonQuest"]:InvokeServer({
            NPC = "Dojo Trainer",
            Command = cmd
        })
    end)
end

Tabs.Draco:AddButton({
    Title = "Auto Dojo Quest",
    Callback = function()
        toposition(dojoPos, function()
            task.wait(.3)
            local q = ReadDojoState()

            if q == nil then
                warn("[DOJO] Quest không tồn tại (acc mới?)")
                return
            end

            warn("[DOJO] Quest State:", q)

            if q == "None" then 
                DojoRemote("RequestQuest")
            elseif q == "Complete" then
                DojoRemote("CompleteQuest")
            end
        end)
    end
})


