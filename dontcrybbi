Tabs.Belt:AddButton({
    Title = "Lụm Fruit Gần Nhất",
    Callback = function()
        local lp = Players.LocalPlayer
        local char = lp.Character
        if not char then return end

        local hrp = char:FindFirstChild("HumanoidRootPart")
        local nearest, dist = nil, math.huge

        for _, v in ipairs(workspace:GetDescendants()) do
            if v:IsA("Tool") and v:FindFirstChild("Handle") then
                local d = (v.Handle.Position - hrp.Position).Magnitude
                if d < dist then
                    dist = d
                    nearest = v
                end
            end
        end

        if nearest then
            toposition(nearest.Handle.CFrame, function()
                task.wait(.1)
                firetouchinterest(hrp, nearest.Handle, 0)
                task.wait()
                firetouchinterest(hrp, nearest.Handle, 1)
            end)
        end
    end
})

Tabs.Belt:AddButton({
    Title = "Drop Fruit",
    Callback = function()
        local lp = Players.LocalPlayer
        local char = lp.Character
        local bp = lp.Backpack
        if not char then return end

        local tool =
            char:FindFirstChildWhichIsA("Tool")
            or bp:FindFirstChildWhichIsA("Tool")

        if not tool then return end

        if tool.Parent == bp then
            char.Humanoid:EquipTool(tool)
            task.wait(.1)
        end

        tool.Parent = workspace
        tool.Handle.CFrame = char.HumanoidRootPart.CFrame
    end
})

