Tabs.Belt:AddButton({
    Title = "Lụm Fruit Gần Nhất",
    Callback = function()
        local char = Players.LocalPlayer.Character
        local hrp = char.HumanoidRootPart

        local nearest, dist = nil, 99999
        for _, tool in ipairs(workspace:GetDescendants()) do
            if tool:IsA("Tool") and tool:FindFirstChild("Handle") then
                local d = (tool.Handle.Position - hrp.Position).Magnitude
                if d < dist then
                    nearest = tool
                    dist = d
                end
            end
        end

        if nearest then
            toposition(nearest.Handle.CFrame, function()
                wait(.1)
                firetouchinterest(hrp, nearest.Handle, 0)
                firetouchinterest(hrp, nearest.Handle, 1)
            end)
        end
    end
})

Tabs.Belt:AddButton({
    Title = "Drop Fruit",
    Callback = function()
        local plr = Players.LocalPlayer
        local char = plr.Character
        local bp = plr.Backpack

        local tool = char:FindFirstChildOfClass("Tool") or bp:FindFirstChildOfClass("Tool")
        if not tool then return end

        if tool.Parent == bp then
            char.Humanoid:EquipTool(tool)
            wait(.1)
        end

        tool.Parent = workspace
        tool.Handle.CFrame = char.HumanoidRootPart.CFrame
    end
})

