local function GetDojoQuest()
    local plr = Players.LocalPlayer
    local data = plr:FindFirstChild("Data")
    if not data then return nil end

    local dojo = data:FindFirstChild("Dojo") -- đúng là Dojo, không phải Dojos
    if not dojo then return nil end

    local quest = dojo:FindFirstChild("Quest")
    if not quest then return nil end

    return quest.Value
end

