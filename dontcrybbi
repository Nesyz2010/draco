        if not hrp then return end

        local nearest = nil
        local minDist = math.huge

        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("Tool") and obj:FindFirstChild("Handle") then
                local d = (obj.Handle.Position - hrp.Position).Magnitude
                if d < minDist then
                    minDist = d
                    nearest = obj
                end
            end
        end

        if not nearest then
            warn("[Fruit] Không tìm thấy trái.")
            return
        end

        print("[Fruit] Found:", nearest.Name)

        toposition(nearest.Handle.CFrame, function()
            task.wait(0.2)
            pcall(function()
                firetouchinterest(hrp, nearest.Handle, 0)
                task.wait()
                firetouchinterest(hrp, nearest.Handle, 1)
            end)
            print("[Fruit] Lụm thành công:", nearest.Name)
        end)
    end
})

