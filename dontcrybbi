-- 🧩 MOVE SYSTEM (TOPOSITION — MOVE LIKE BUY MELEE)
------------------------------------------------------------
local TweenService = game:GetService("TweenService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local SPEED = 260

local function toposition(Pos, onDone)
    local plr = Players.LocalPlayer
    local char = plr.Character or plr.CharacterAdded:Wait()
    local hrp = char:WaitForChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")

    local root = char:FindFirstChild("Root")
    if not root then
        root = Instance.new("Part")
        root.Name = "Root"
        root.Size = Vector3.new(20, 0.5, 20)
        root.Transparency = 1
        root.CanCollide = false
        root.Anchored = true
        root.CFrame = hrp.CFrame
        root.Parent = char
    end

    if hum and hum.Sit then hum.Sit = false end

    local dist = (Pos.Position - hrp.Position).Magnitude
    local info = TweenInfo.new(dist / SPEED, Enum.EasingStyle.Linear)

    if dist <= 10 then
        hrp.CFrame = Pos
        if onDone then onDone() end
        return
    end

    local tween = TweenService:Create(root, info, { CFrame = Pos })
    tween:Play()

    task.spawn(function()
        while tween.PlaybackState == Enum.PlaybackState.Playing do
            task.wait()
            hrp.CFrame = root.CFrame
        end
    end)

    tween.Completed:Once(function()
        hrp.CFrame = root.CFrame
        if onDone then onDone() end
    end)
end

