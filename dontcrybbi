    Callback = function()
        toposition(dojoPos, function()
            wait(.3)
            local q = GetDojoQuest()
            warn("[DOJO] Quest State:", q)

            if q == nil then
                warn("[DOJO] Quest chưa tồn tại (acc mới?)")
                return
            end

            if q == "None" then
                Dojo_Request()
            elseif q == "Complete" then
                Dojo_Complete()
            else
                warn("[DOJO] Trạng thái không hợp lệ:", q)
            end
        end)
    end
})

