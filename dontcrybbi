Tabs.Belt:AddButton({
    Title = "Lụm Fruit Gần Nhất",
    Callback = function()
        local lp = Players.LocalPlayer
        local hrp = lp.Character.HumanoidRootPart

        local nearest, minDist = nil, 99999
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("Tool") and obj:FindFirstChild("Handle") then
                local d = (obj.Handle.Position - hrp.Position).Magnitude
                if d < minDist then
                    minDist = d
                    nearest = obj
                end
            end
        end

        if nearest then
            toposition(nearest.Handle.CFrame, function()
                task.wait(.1)
                firetouchinterest(hrp, nearest.Handle, 0)
                task.wait()
                firetouchinterest(hrp, nearest.Handle, 1)
            end)
        end
    end
})

