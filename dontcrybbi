-- 🧩 DRACO — AUTO CHECK / ACCEPT / COMPLETE QUEST
------------------------------------------------------------
local dojoPos = CFrame.new(5865.9468, 1208.5947, 872.6288)
local RF = game.ReplicatedStorage.Modules.Net["RF/InteractDragonQuest"]

local function dojoRemote(cmd)
    local args = {
        [1] = {
            NPC = "Dojo Trainer",
            Command = cmd
        }
    }
    return pcall(function()
        RF:InvokeServer(unpack(args))
    end)
end

local function getQuestState()
    return Players.LocalPlayer.Data.Dojos.Quest.Value
end

local function autoDojo()
    print("========== DOJO AUTO QUEST ==========")
    print("[System] Teleporting to Dojo...")

    toposition(dojoPos, function()
        task.wait(0.3)

        local state = getQuestState()
        print("[Dojo] Quest State:", state)

        if state == "None" then
            print("[Dojo] Chưa có quest → Nhận mới...")
            dojoRemote("RequestQuest")
            print("[Dojo] Đã nhận quest!")

        elseif state == "Complete" then
            print("[Dojo] Quest hoàn thành → Trả quest...")
            dojoRemote("CompleteQuest")
            print("[Dojo] Đã trả quest!")

        else
            print("[Dojo] Đang làm quest → Không làm gì.")
        end

        print("======================================")
    end)
end

Tabs.Draco:AddButton({
    Title = "Auto Dojo Quest",
    Description = "Tele → Kiểm tra → Nhận hoặc Trả quest tự động",
    Callback = function()
        autoDojo()
    end
})

