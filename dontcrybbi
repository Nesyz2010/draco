local BeltNames = {
    [0] = "White",
    [1] = "Yellow",
    [2] = "Orange",
    [3] = "Green",
    [4] = "Blue",
    [5] = "Purple",
    [6] = "Red",
    [7] = "Black"
}

local function getCurrentBelt()
    local beltVal = Players.LocalPlayer.Data.Dojos.Belt.Value
    local current = BeltNames[beltVal] or "Unknown"
    local nextBelt = BeltNames[beltVal + 1] or "MAX"
    return current, nextBelt
end

local cur, nxt = getCurrentBelt()

local BeltLabel = Tabs.Draco:AddParagraph({
    Title = "Dojo Belt",
    Content = "Current: " .. cur .. "\nNext: " .. nxt
})

task.spawn(function()
    while task.wait(1) do
        local a, b = getCurrentBelt()
        BeltLabel:SetDesc("Current: " .. a .. "\nNext: " .. b)
    end
end)

