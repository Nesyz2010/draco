Tabs.Belt:AddButton({
    Title = "Lụm Fruit Gần Nhất",
    Callback = function()
        local lp = Players.LocalPlayer
        local char = lp.Character
        local hrp = char:FindFirstChild("HumanoidRootPart")

        local nearest, minDist = nil, math.huge
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("Tool") and obj:FindFirstChild("Handle") then
                local d = (obj.Handle.Position - hrp.Position).Magnitude
                if d < minDist then
                    minDist = d
                    nearest = obj
                end
            end
        end
        if not nearest then return end

        toposition(nearest.Handle.CFrame, function()
            task.wait(.1)
            firetouchinterest(hrp, nearest.Handle, 0)
            task.wait()
            firetouchinterest(hrp, nearest.Handle, 1)
        end)
    end
})

Tabs.Belt:AddButton({
    Title = "Drop Fruit",
    Callback = function()
        local plr = Players.LocalPlayer
        local char = plr.Character
        local bp = plr.Backpack

        local tool = char:FindFirstChildWhichIsA("Tool") or bp:FindFirstChildWhichIsA("Tool")
        if not tool then return end

        if tool.Parent == bp then
            char.Humanoid:EquipTool(tool)
            task.wait(.1)
        end

        tool.Parent = workspace
        tool.Handle.CFrame = char.HumanoidRootPart.CFrame
    end
})

