local dojoPos = CFrame.new(5865.9468, 1208.5947, 872.6288)
local RF_Dragon = ReplicatedStorage.Modules.Net["RF/InteractDragonQuest"]

-- Dojo Trainer Quest (FIXED)
local function dojoRemote(cmd)
    local args = {
        NPC = "Dojo Trainer",
        Command = cmd
    }

    pcall(function()
        RF_Dragon:InvokeServer(args)
    end)

    warn("[DOJO] Sent:", cmd)
end

Tabs.Draco:AddButton({
    Title = "Auto Dojo Quest",
    Callback = function()
        toposition(dojoPos, function()
            task.wait(.3)

            local data = Players.LocalPlayer:FindFirstChild("Data")
            if not data then
                warn("[DOJO] Không tìm thấy folder Data")
                return
            end

            local dojoFolder = data:FindFirstChild("Dojo")
            if not dojoFolder then
                warn("[DOJO] Acc mới? Chưa có Dojo Quest")
                return
            end

            local q = dojoFolder:FindFirstChild("Quest")
            if not q then
                warn("[DOJO] Quest state not found")
                return
            end

            warn("[DOJO] Quest State:", q.Value)

            if q.Value == "None" then
                dojoRemote("RequestQuest")
            elseif q.Value == "Complete" then
                dojoRemote("CompleteQuest")
            end
        end)
    end
})

