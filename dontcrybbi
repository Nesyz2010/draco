-- MOVE FUNCTION (Tween di chuyển)
------------------------------------------------------------
local TweenService = game:GetService("TweenService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SPEED = 260

local function toposition(Pos, onDone)
    local lp = Players.LocalPlayer
    local char = lp.Character or lp.CharacterAdded:Wait()
    local hrp = char:WaitForChild("HumanoidRootPart")

    local root = char:FindFirstChild("Root")
    if not root then
        root = Instance.new("Part")
        root.Name = "Root"
        root.Anchored = true
        root.Transparency = 1
        root.CanCollide = false
        root.Size = Vector3.new(20, 0.5, 20)
        root.CFrame = hrp.CFrame
        root.Parent = char
    end

    local dist = (Pos.Position - hrp.Position).Magnitude
    local tween = TweenService:Create(
        root,
        TweenInfo.new(dist / SPEED, Enum.EasingStyle.Linear),
        { CFrame = Pos }
    )

    tween:Play()

    task.spawn(function()
        while tween.PlaybackState == Enum.PlaybackState.Playing do
            task.wait()
            hrp.CFrame = root.CFrame
        end
    end)

    tween.Completed:Once(function()
        hrp.CFrame = root.CFrame
        if onDone then onDone() end
    end)
end

