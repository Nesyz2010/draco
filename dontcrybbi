Tabs.Belt:AddButton({
    Title = "Lụm Fruit Gần Nhất\n• Auto tele → lụm trái gần nhất",
    Callback = function()
        local lp = Players.LocalPlayer
        local hrp = lp.Character:FindFirstChild("HumanoidRootPart")
        if not hrp then return end

        local nearest, dist = nil, math.huge
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("Tool") and obj:FindFirstChild("Handle") then
                local d = (obj.Handle.Position - hrp.Position).Magnitude
                if d < dist then
                    dist = d
                    nearest = obj
                end
            end
        end

        if nearest then
            toposition(nearest.Handle.CFrame, function()
                task.wait(.1)
                firetouchinterest(hrp, nearest.Handle, 0)
                task.wait()
                firetouchinterest(hrp, nearest.Handle, 1)
            end)
        end
    end
})

