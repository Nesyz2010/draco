local LP = Players.LocalPlayer

local function IfTableHaveIndex(t)
    if type(t) ~= "table" then return false end
    for _ in pairs(t) do
        return true
    end
    return false
end

local ServerBrowser = ReplicatedStorage:FindFirstChild("__ServerBrowser")

local LastServersDataPulled, CachedServers

local function GetServers()
    if not ServerBrowser then return nil end

    if LastServersDataPulled and CachedServers then
        if os.time() - LastServersDataPulled < (getgenv().CacheSeconds or 60) then
            return CachedServers
        end
    end

    for page = 1, 100 do
        local ok, data = pcall(function()
            return ServerBrowser:InvokeServer(page)
        end)
        if ok and IfTableHaveIndex(data) then
            LastServersDataPulled = os.time()
            CachedServers = data
            return data
        end
    end

    return nil
end

local function BuildArrayServers(Servers)
    local arr = {}
    for jobId, v in pairs(Servers) do
        if type(v) == "table" then
            table.insert(arr, {
                JobId = jobId,
                Players = tonumber(v.Count) or 0,
                LastUpdate = v.__LastUpdate,
                Region = v.Region
            })
        end
    end
    return arr
end

local function PickServer(ArrayServers, MaxPlayers, ForcedRegion)
    if not ArrayServers or #ArrayServers == 0 then return nil end

    MaxPlayers = tonumber(MaxPlayers)
    ForcedRegion = (ForcedRegion and tostring(ForcedRegion):gsub("^%s+", ""):gsub("%s+$", "")) or ""
    if ForcedRegion == "" then ForcedRegion = nil end

    for i = #ArrayServers, 2, -1 do
        local j = math.random(1, i)
        ArrayServers[i], ArrayServers[j] = ArrayServers[j], ArrayServers[i]
    end

    for _, s in ipairs(ArrayServers) do
        if s and s.JobId then
            if (not MaxPlayers) or (s.Players <= MaxPlayers) then
                if (not ForcedRegion) or (s.Region == ForcedRegion) then
                    if getgenv().DontHopSameServer and s.JobId == game.JobId then
                    else
                        return s
                    end
                end
            end
        end
    end

    return nil
end

local function HopServer(Reason, MaxPlayers, ForcedRegion)
    local Servers = GetServers()
    if not Servers then return false, "GetServers failed" end

    local ArrayServers = BuildArrayServers(Servers)
    local server = PickServer(ArrayServers, MaxPlayers, ForcedRegion)
    if not server then
        return false, "No matching server"
    end

    TeleportService:TeleportToPlaceInstance(game.PlaceId, server.JobId, LP)
    return true, "Teleporting..."
end

