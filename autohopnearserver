    local maxPlayers = resolveMaxPlayersFromUI()
    local region = regBox.Text

    setStatus("Searching...")
    local ok, msg = HopServer("GUI", maxPlayers, region)
    setStatus(msg)
end)

setStatus("Ready")

-- AUTO HOP GIỮ NGUYÊN
local lastAutoHop = 0

local function getHRP(plr)
    local ch = plr and plr.Character
    return ch and ch:FindFirstChild("HumanoidRootPart")
end

task.spawn(function()
    while gui and gui.Parent do
        task.wait(getgenv().NearCheckEvery)

        if not getgenv().AutoHopNearPlayers then continue end
        if os.clock() - lastAutoHop < getgenv().AutoHopCooldown then continue end

        local myHRP = getHRP(LP)
        if not myHRP then continue end

        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LP then
                local hrp = getHRP(p)
                if hrp and (hrp.Position - myHRP.Position).Magnitude <= getgenv().NearDistance then
                    lastAutoHop = os.clock()
                    setStatus("Player near -> hopping")
                    HopServer("Auto", resolveMaxPlayersFromUI(), regBox.Text)
                    break
                end
            end
        end
    end
end)
