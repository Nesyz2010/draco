    local ok, result = pcall(function()
        return serverBrowser:InvokeServer("teleport", jobId)
    end)

    warn(
        "[Blue Belt] Join requester JobId:",
        jobId,
        "| ok:",
        ok,
        "| result:",
        result
    )

    return ok
end

