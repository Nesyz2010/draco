--==============================================================
-- CONNECTION REJOIN
-- Reconnects after a normal disconnect. No external console is used.
--==============================================================
local orangeRejoinBusy = false

local function orangeConnectionRejoin(reason)
    if orangeRejoinBusy then
        return
    end

    orangeRejoinBusy = true
    orangeSessionActive = false
    orangeTeleporting = true

    pcall(function()
        orangeHeartbeat("connection_lost")
    end)

    task.spawn(function()
        task.wait(3)

        local serverBrowser =
            ReplicatedStorage:FindFirstChild("__ServerBrowser")
            or ReplicatedStorage:WaitForChild("__ServerBrowser", 8)

        if serverBrowser and game.JobId ~= "" then
            local ok = pcall(function()
                return serverBrowser:InvokeServer(
                    "teleport",
                    game.JobId
                )
            end)

            if ok then
                return
            end
        end

        pcall(function()
            TeleportService:Teleport(game.PlaceId, plr)
        end)

        task.wait(10)
        orangeTeleporting = false
        orangeRejoinBusy = false
    end)
end

pcall(function()
    local networkClient = game:GetService("NetworkClient")
    networkClient.ChildRemoved:Connect(function()
        orangeConnectionRejoin("network_removed")
    end)
end)

