local function orangeRecoverMissingSession(context)
    warn(
        "[Orange Belt] Session bị mất tại",
        tostring(context or "unknown"),
        "- đang register/match lại"
    )

    orangeSessionActive = false
    orangeAutoTradeRunning = false
    orangeAutoTradeFinished = false
    orangeSessionVersion = nil

    local registered = orangeRegister("session_lost_rematch")
    if not registered or registered.success ~= true then
        warn("[Orange Belt] Register lại sau session_not_found thất bại.")
        return false
    end

    local rematch = orangeMatchRequest()
    if rematch and rematch.success == true then
        local version = tonumber(rematch.session_version)
            or (type(rematch.session) == "table"
                and tonumber(rematch.session.version))
        if version then
            orangeSessionVersion = version
        end
        warn("[Orange Belt] Đã nhận session mới, vòng chính sẽ tiếp tục.")
        return true
    end

    if rematch and rematch.hop_required == true then
        warn(
            "[Orange Belt] Rematch yêu cầu hop:",
            tostring(rematch.error or "server_unavailable")
        )
        if getgenv().OrangeHopLowestServer then
            getgenv().OrangeHopLowestServer()
        end
        return false
    end

    warn(
        "[Orange Belt] Chưa rematch được:",
        tostring(rematch and rematch.error or "unknown")
    )
    return false
end

