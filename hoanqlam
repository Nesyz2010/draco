local ORANGE_RUNNER_TOKEN =
    HttpService:GenerateGUID(false)

getgenv().VortexZOrangeRunnerToken =
    ORANGE_RUNNER_TOKEN

getgenv().RunOrangeBeltStandalone = function()
    local runner = getgenv().DracoRunOrangeBelt

    if type(runner) ~= "function" then
        warn("[ORANGE BELT] Runner chưa được export.")
        return false
    end

    local ok, result = xpcall(
        runner,
        debug.traceback
    )

    if not ok then
        warn("[ORANGE BELT] Runtime error:", result)
        return false
    end

    return result == true
end

task.spawn(function()
    task.wait(2)

    while getgenv().VortexZOrangeRunnerToken
        == ORANGE_RUNNER_TOKEN do

        if hasBelt("Orange Belt") then
            getgenv().DracoFlowUI:SetStatus(
                "ORANGE BELT COMPLETE"
            )
            return
        end

        local runner = getgenv().DracoRunOrangeBelt

        if type(runner) ~= "function" then
            orangeSetStatus(
                "ORANGE BELT • INITIALIZING",
                "Đang chờ module trade được export"
            )
            task.wait(2)
        else
            orangeSetStatus(
                "ORANGE BELT • START",
                "Đang đăng ký queue và tìm cặp"
            )
            local ok, result = xpcall(
                runner,
                debug.traceback
            )

            if not ok then
                warn("[ORANGE BELT] Runtime error:", result)

                pcall(function()
                    orangeCancel("runtime_error")
                end)
                pcall(function()
                    orangeRelease()
                end)

                orangeSessionActive = false
                orangeTeleporting = false
                task.wait(5)
            elseif result == true then
                getgenv().DracoFlowUI:SetStatus(
                    "ORANGE BELT COMPLETE"
                )
                return
            else
                if not orangeTeleporting then
                    pcall(function()
                        local state = orangeCheck()
                        local session = state and state.session

                        if session and (
                            session.status == "failed"
                            or session.status == "expired"
                            or session.status == "cancelled"
                        ) then
                            orangeRelease()
                        end
                    end)

                    orangeSessionActive = false
                end

                task.wait(3)
            end
        end
    end
end)
