--==================================================
-- BLUE BELT: TWO ACCOUNT DROP / COLLECT / BOTH CLAIM
--==================================================
do
    local BlueNet = ReplicatedStorage
        :WaitForChild("Modules")
        :WaitForChild("Net")
        :WaitForChild("RF/InteractDragonQuest")

    local BlueRuntime = {
        actionBusy = false,
        lastPhase = "",
        lastCycle = -1,
    }

    local function blueApi(method, path, body)
        local api = getgenv().DracoOrangeApi
        if type(api) ~= "function" then
            warn("[Blue Belt] Shared HTTP API chưa sẵn sàng.")
            return nil
        end
        return api(method, path, body)
    end

    local function blueState(action, extra)
        local suffix = "?username="
            .. HttpService:UrlEncode(plr.Name)
            .. "&instance_id="
            .. HttpService:UrlEncode(ORANGE_INSTANCE_ID)

        if action then
            local body = extra or {}
            body.action = action
            body.instance_id = ORANGE_INSTANCE_ID
            body.session_version = orangeSessionVersion
            return blueApi(
                "POST",
                "/api/blue-state" .. suffix,
                body
            )
        end

        return blueApi("GET", "/api/blue-state" .. suffix)
    end

    local function blueMatch()
        return blueApi("POST", "/api/blue-match", {
            username = plr.Name,
            user_id = tostring(plr.UserId),
            job_id = game.JobId,
            place_id = tostring(game.PlaceId),
            instance_id = ORANGE_INSTANCE_ID,
            tenant_id = ORANGE_TENANT_ID,
        })
    end

    local function blueInvokeQuest(command)
        local args = {
            {
                NPC = "Dojo Trainer",
                Command = command,
            }
        }

        local ok, result = pcall(function()
            return BlueNet:InvokeServer(unpackArgs(args))
        end)

        warn(
            "[Blue Belt]",
            command,
            "| ok:",
            ok,
            "| result:",
            result
        )

        return ok, result
    end

    local function blueRequestQuest()
        setCurrentBeltPhase("BLUE BELT")
        ensureReturnedToTikiBeforeDojo()

        if getgenv().DracoFlowUI then
            getgenv().DracoFlowUI:SetStatus(
                "BLUE BELT • REQUEST QUEST"
            )
            getgenv().DracoFlowUI:SetSubStatus(
                "Đang request nhiệm vụ và chờ acc còn lại"
            )
        end

        toposition(Config.DOJO_POS)
        task.wait(0.6)

        blueInvokeQuest("ClaimQuest")
        task.wait(0.5)

        if hasBelt(Config.BLUE_BELT) then
            return true
        end

        blueInvokeQuest("RequestQuest")
        task.wait(1)
        return true
    end

    local function blueIsFruitTool(tool)
        if not tool or not tool:IsA("Tool") then
            return false
        end

        return tool:FindFirstChild("Fruit") ~= nil
            or tool:FindFirstChild("EatRemote", true) ~= nil
            or string.find(
                string.lower(tool.Name),
                "fruit",
                1,
                true
            ) ~= nil
    end

    local function blueFindFruitTool(container)
        if not container then
            return nil
        end

        for _, tool in ipairs(container:GetChildren()) do
            if blueIsFruitTool(tool) then
                return tool
            end
        end

        return nil
    end

    local function blueHasHeldFruit()
        return blueFindFruitTool(plr.Character)
            or blueFindFruitTool(
                plr:FindFirstChildOfClass("Backpack")
            )
    end

    local function blueEquipFruit(allowRandom)
        local char, hum = getCharacter()
        local backpack = plr:FindFirstChildOfClass("Backpack")
        local tool = blueFindFruitTool(char)
            or blueFindFruitTool(backpack)

        if not tool and allowRandom then
            if getgenv().DracoFlowUI then
                getgenv().DracoFlowUI:SetStatus(
                    "BLUE BELT • RANDOM FRUIT"
                )
                getgenv().DracoFlowUI:SetSubStatus(
                    "Acc này là fruit owner, đang random một fruit"
                )
            end

            pcall(function()
                rem:InvokeServer("Cousin", "Buy")
            end)

            task.wait(1)

            for _ = 1, 5 do
                tool = blueFindFruitTool(backpack)
                    or blueFindFruitTool(char)
                if tool then
                    break
                end
                task.wait(0.5)
            end
        end

        if not tool then
            return nil
        end

        if tool.Parent ~= char then
            hum:EquipTool(tool)
            task.wait(1)
        end

        return blueFindFruitTool(char)
    end

    local function blueFindGroundFruit()
        local center = Config.BLUE_DROP_POS.Position
        local nearest = nil
        local nearestDistance = math.huge

        for _, item in ipairs(Workspace:GetChildren()) do
            local handle = item:FindFirstChild("Handle")
            local looksFruit =
                item:IsA("Tool")
                or item:FindFirstChild("Fruit") ~= nil
                or item:FindFirstChild("EatRemote", true) ~= nil
                or string.find(
                    string.lower(item.Name),
                    "fruit",
                    1,
                    true
                ) ~= nil

            if handle and looksFruit then
                local distance =
                    (handle.Position - center).Magnitude

                if distance <= Config.BLUE_PICK_RADIUS
                    and distance < nearestDistance then
                    nearest = item
                    nearestDistance = distance
                end
            end
        end

        return nearest
    end

    local function blueDropHeldFruit()
        toposition(Config.BLUE_DROP_POS)
        task.wait(0.5)

        local tool = blueEquipFruit(false)
        if not tool then
            warn("[Blue Belt] Không có fruit trong tay để drop.")
            return false
        end

        local remote = tool:FindFirstChild("EatRemote", true)
        if not remote then
            return false
        end

        -- Giữ delay drop từ source cũ.
        task.wait(1.5)

        local ok, result = pcall(function()
            return remote:InvokeServer("Drop")
        end)

        warn("[Blue Belt] Drop:", tool.Name, ok, result)

        if not ok then
            return false
        end

        local started = tick()
        while tick() - started < 8 do
            if blueFindGroundFruit() then
                return true
            end
            task.wait(0.25)
        end

        return false
    end

    local function blueCollectFruit()
        toposition(Config.BLUE_DROP_POS)

        local started = tick()

        while tick() - started < 15 do
            if blueHasHeldFruit() then
                return true
            end

            local item = blueFindGroundFruit()

            if item then
                local handle = item:FindFirstChild("Handle")
                if handle then
                    toposition(
                        handle.CFrame * CFrame.new(0, 2, 0)
                    )
                    task.wait(0.5)

                    if firetouchinterest then
                        local _, _, root = getCharacter()
                        pcall(function()
                            firetouchinterest(root, handle, 0)
                            task.wait()
                            firetouchinterest(root, handle, 1)
                        end)
                    end

                    task.wait(0.8)

                    if blueHasHeldFruit() then
                        return true
                    end
                end
            end

            task.wait(0.25)
        end

        return false
    end

    local function blueClaimOnce()
        toposition(Config.DOJO_POS)
        task.wait(0.6)
        blueInvokeQuest("ClaimQuest")
        task.wait(1)
        return hasBelt(Config.BLUE_BELT)
    end

    local function blueRunAction(callback)
        if BlueRuntime.actionBusy then
            return false
        end

        BlueRuntime.actionBusy = true
        local ok, result = pcall(callback)
        BlueRuntime.actionBusy = false

        if not ok then
            warn("[Blue Belt] Action runtime error:", result)
            return false
        end

        return result
    end

    local function runBlueBelt()
        setCurrentBeltPhase("BLUE BELT")

        if hasBelt(Config.BLUE_BELT) then
            return true
        end

        local matched = blueMatch()

        if not matched or not matched.success then
            task.wait(3)
            return false
        end

        -- Requester must hop to a low-player server before any
        -- quest/drop/collect function is allowed to start.
        if matched.role == "requester" then
            local syncedJob = tostring(
                matched.session
                and matched.session.job_id
                or ""
            )

            if matched.job_synced == true then
                getgenv().BlueRequesterLowReady = true

                warn(
                    "[Blue Belt] Requester synced low-server JobId:",
                    syncedJob ~= "" and syncedJob or game.JobId
                )
            elseif getgenv().BlueRequesterLowReady ~= true then
                local pendingTarget =
                    tostring(getgenv().BlueRequesterHopTarget or "")
                local pendingAt =
                    tonumber(getgenv().BlueRequesterHopAt) or 0

                if pendingTarget ~= ""
                    and tick() - pendingAt < 15 then
                    warn(
                        "[Blue Belt] Requester đang chờ teleport low server:",
                        pendingTarget
                    )
                    return false
                end

                blueHopLowestServer()
                return false
            end
        end

        if matched.role == "helper" and matched.join then
            local targetJob = tostring(matched.join.job_id or "")
            local targetPlace = matched.join.place_id

            warn(
                "[Blue Belt] Helper server check | current:",
                game.JobId,
                "| target:",
                targetJob
            )

            if targetJob ~= "" and game.JobId ~= targetJob then
                if getgenv().BlueJoinPendingJob == targetJob
                    and tick() - (
                        getgenv().BlueJoinPendingAt or 0
                    ) < 15 then
                    return false
                end

                getgenv().BlueJoinPendingJob = targetJob
                getgenv().BlueJoinPendingAt = tick()

                local joinFunction =
                    getgenv().DracoOrangeJoinJob

                if type(joinFunction) == "function" then
                    joinFunction(targetPlace, targetJob)
                end

                return false
            end

            -- Arrived at the authoritative requester server.
            getgenv().BlueJoinPendingJob = nil
            getgenv().BlueJoinPendingAt = 0
        end

        -- Hard gate: Blue Belt logic starts only after both accounts
        -- are in the authoritative requester JobId.
        local finalCheck = blueMatch()

        if not finalCheck or not finalCheck.success then
            return false
        end

        local authoritativeJob = tostring(
            finalCheck.session
            and finalCheck.session.job_id
            or ""
        )

        if authoritativeJob ~= ""
            and game.JobId ~= authoritativeJob then

            if finalCheck.role == "helper"
                and finalCheck.join then

                local joinFunction =
                    getgenv().DracoOrangeJoinJob

                if type(joinFunction) == "function" then
                    joinFunction(
                        finalCheck.join.place_id,
                        authoritativeJob
                    )
                end
            end

            warn(
                "[Blue Belt] Chưa cùng requester JobId | current:",
                game.JobId,
                "| target:",
                authoritativeJob
            )

            return false
        end

        blueHeartbeat("blue_same_server_ready")
        blueRequestQuest()
        blueState("quest_ready")

        local started = tick()

        while tick() - started < 900 do
            local response = blueState()
            local state = response and response.blue
            local phase = state and state.phase or "waiting_helper"
            local owner = state and state.fruit_owner
            local partner = state and state.partner
            local cycle = tonumber(state and state.cycle) or 0
            local isOwner = owner == plr.Name
            local isPartner = partner == plr.Name

            if phase ~= BlueRuntime.lastPhase
                or cycle ~= BlueRuntime.lastCycle then
                warn(
                    "[Blue Belt] Phase:",
                    phase,
                    "| owner:",
                    owner,
                    "| partner:",
                    partner,
                    "| cycle:",
                    cycle
                )
                BlueRuntime.lastPhase = phase
                BlueRuntime.lastCycle = cycle
            end

            if getgenv().DracoFlowUI then
                getgenv().DracoFlowUI:SetStatus(
                    "BLUE BELT • "
                    .. string.upper(
                        string.gsub(phase, "_", " ")
                    )
                )
                getgenv().DracoFlowUI:SetSubStatus(
                    "Owner: " .. tostring(owner)
                    .. "\nCycle: " .. tostring(cycle)
                )
            end

            if phase == "waiting_helper"
                or phase == "waiting_both_quest" then
                task.wait(1)

            elseif phase == "owner_random" and isOwner then
                blueRunAction(function()
                    toposition(Config.BLUE_DROP_POS)

                    local tool = blueEquipFruit(true)
                    if tool then
                        blueState("owner_randomed")
                        return true
                    end

                    return false
                end)

            elseif phase == "owner_drop" and isOwner then
                blueRunAction(function()
                    if blueDropHeldFruit() then
                        blueState("owner_dropped")
                        return true
                    end

                    -- Fruit không xuất hiện hoặc đã mất.
                    blueState("fruit_lost")
                    return false
                end)

            elseif phase == "partner_collect" and isPartner then
                blueRunAction(function()
                    if blueCollectFruit() then
                        blueState("partner_collected")
                        return true
                    end

                    blueState("fruit_lost")
                    return false
                end)

            elseif phase == "partner_drop_back" and isPartner then
                blueRunAction(function()
                    if blueDropHeldFruit() then
                        blueState("partner_dropped_back")
                        return true
                    end

                    blueState("fruit_lost")
                    return false
                end)

            elseif phase == "owner_collect_back" and isOwner then
                blueRunAction(function()
                    if blueCollectFruit() then
                        blueState("owner_collected_back")
                        return true
                    end

                    blueState("fruit_lost")
                    return false
                end)

            elseif phase == "both_claim" then
                blueRunAction(function()
                    local hasBlue = blueClaimOnce()

                    blueState("claim_result", {
                        has_belt = hasBlue,
                    })

                    return true
                end)

            elseif phase == "completed" then
                if hasBelt(Config.BLUE_BELT) then
                    blueState("release")
                    return true
                end

                -- Server says completed but local inventory has not
                -- replicated yet; claim/check once more.
                blueClaimOnce()
            end

            local pollDelay = 1.75
            if phase == "owner_random"
                or phase == "owner_drop"
                or phase == "partner_collect"
                or phase == "partner_drop_back"
                or phase == "owner_collect_back"
                or phase == "both_claim" then
                pollDelay = 0.75
            end
            task.wait(pollDelay + math.random() * 0.2)
        end

        warn("[Blue Belt] Coordinator timeout.")
        return hasBelt(Config.BLUE_BELT)
    end

    getgenv().DracoRunBlueBelt = runBlueBelt
end



