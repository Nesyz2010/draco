-- BLUE BELT INVENTORY CHECK
--==============================================================
local function normalizeItemName(value)
    local name = string.lower(tostring(value or ""))
    name = string.gsub(name, "[%(%)]", "")
    name = string.gsub(name, "[%s_%-]+", "")
    return name
end

local function isBlueBeltName(value)
    local name = normalizeItemName(value)

    return name == "bluebelt"
        or name == "dojobeltblue"
end

local function hasBelt(beltName)
    if tostring(beltName) ~= "Blue Belt" then
        return false
    end

    local ok, inventory = pcall(function()
        return rem:InvokeServer("getInventory")
    end)

    if ok and type(inventory) == "table" then
        for _, item in pairs(inventory) do
            if type(item) == "table" then
                local actualName =
                    item.Name
                    or item.ItemName
                    or item.DisplayName
                    or item.name

                if isBlueBeltName(actualName) then
                    return true
                end
            elseif type(item) == "string"
                and isBlueBeltName(item) then
                return true
            end
        end
    end

    local function scan(container)
        if not container then
            return false
        end

        for _, object in ipairs(container:GetChildren()) do
            if isBlueBeltName(object.Name) then
                return true
            end
        end

        return false
    end

    return scan(plr:FindFirstChildOfClass("Backpack"))
        or scan(plr.Character)
end

--==============================================================
-- HTTP API
--==============================================================
local function getHttpRequest()
    return request
        or http_request
        or (syn and syn.request)
        or (http and http.request)
end

local function sharedApi(method, path, body)
    local httpRequest = getHttpRequest()

    if type(httpRequest) ~= "function" then
        warn("[Blue Belt] Executor không hỗ trợ HTTP request.")
        return nil
    end

    local ok, response = pcall(function()
        return httpRequest({
            Url = ORANGE_SERVER_URL .. path,
            Method = method,
            Headers = {
                ["Content-Type"] = "application/json",
                ["X-API-Key"] = ORANGE_API_KEY,
                ["X-Instance-Id"] = ORANGE_INSTANCE_ID,
                ["X-Tenant-Id"] = ORANGE_TENANT_ID,
            },
            Body = body
                and HttpService:JSONEncode(body)
                or nil,
            Timeout = 12,
        })
    end)

    if not ok or not response then
        warn("[Blue Belt] HTTP lỗi:", path, response)
        return nil
    end

    local statusCode =
        tonumber(response.StatusCode)
        or tonumber(response.Status)
        or 0

    local rawBody = response.Body or response.body or ""

    local decodedOk, decoded = pcall(function()
        return HttpService:JSONDecode(rawBody)
    end)

    if not decodedOk or type(decoded) ~= "table" then
        warn(
            "[Blue Belt] API response không hợp lệ:",
            path,
            statusCode,
            rawBody
        )
        return nil
    end

    decoded._status_code = statusCode

    local version =
        tonumber(decoded.session_version)
        or (
            type(decoded.session) == "table"
            and tonumber(decoded.session.version)
        )

    if version then
        orangeSessionVersion = version
    end

    if statusCode < 200 or statusCode >= 300 then
        warn(
            "[Blue Belt] API từ chối:",
            path,
            statusCode,
            tostring(decoded.error)
        )
    end

    return decoded
end

getgenv().DracoOrangeApi = sharedApi

