local function getHttpRequest()
    return request
        or http_request
        or (syn and syn.request)
        or (http and http.request)
end

local function orangeApi(method, path, body)
    if orangeApiDisabled then
        return {
            success = false,
            error = "api_disabled_for_replaced_instance",
        }
    end

    if tick() < orangeCircuitOpenUntil then
        return {
            success = false,
            error = "api_circuit_open",
            retry_after = math.ceil(
                orangeCircuitOpenUntil - tick()
            ),
        }
    end

    local httpRequest = getHttpRequest()
    if type(httpRequest) ~= "function" then
        warn("[Orange Belt] Executor không hỗ trợ HTTP request.")
        return nil
    end

    local waitStarted = tick()
    while orangeHttpBusy do
        if tick() - waitStarted > ORANGE_HTTP_TIMEOUT then
            warn("[Orange Belt] HTTP queue timeout:", path)
            return {
                success = false,
                error = "client_http_queue_timeout",
            }
        end
        task.wait(0.05)
    end

    orangeHttpBusy = true

    local function finish(value)
        orangeHttpBusy = false
        return value
    end

    for attempt = 1, ORANGE_HTTP_RETRIES do
        local ok, response = pcall(function()
            return httpRequest({
                Url = ORANGE_SERVER_URL .. path,
                Method = method,
                Headers = {
                    ["Content-Type"] = "application/json",
                    ["X-API-Key"] = ORANGE_API_KEY,
                    ["X-Instance-Id"] = ORANGE_INSTANCE_ID,
                    ["X-Tenant-Id"] = ORANGE_TENANT_ID,
                },
                Body = body
                    and HttpService:JSONEncode(body)
                    or nil,
                Timeout = ORANGE_HTTP_TIMEOUT,
            })
        end)

        if ok and response then
            local statusCode = tonumber(response.StatusCode)
                or tonumber(response.Status)
                or tonumber(response.status_code)
                or 0
            local responseBody =
                response.Body or response.body or ""
            local decodeOk, decoded = pcall(function()
                return HttpService:JSONDecode(responseBody)
            end)

            if decodeOk and type(decoded) == "table" then
                decoded._status_code = statusCode

                if statusCode >= 200 and statusCode < 300 then
                    orangeHttpFailures = 0

                    local version =
                        tonumber(decoded.session_version)
                        or (
                            type(decoded.session) == "table"
                            and tonumber(decoded.session.version)
                        )

                    if version then
                        orangeSessionVersion = version
                    end

                    return finish(decoded)
                end

                local apiError = tostring(decoded.error or "")

                if apiError == "instance_replaced" then
                    orangeApiDisabled = true
                    orangeSessionActive = false

                    if getgenv().DracoFlowUI then
                        getgenv().DracoFlowUI:SetStatus(
                            "API INSTANCE REPLACED"
                        )
                        getgenv().DracoFlowUI:SetSubStatus(
                            "Acc này đang chạy ở tab khác; tab cũ đã dừng API"
                        )
                    end

                    warn(
                        "[Orange Belt] Tab này đã bị tab mới thay thế:",
                        plr.Name
                    )
                    return finish(decoded)
                end

                local retryable =
                    statusCode == 0
                    or statusCode == 408
                    or statusCode == 425
                    or statusCode == 429
                    or statusCode >= 500

                if not retryable then
                    warn(
                        "[Orange Belt] API từ chối:",
                        path,
                        statusCode,
                        apiError
                    )
                    return finish(decoded)
                end

                warn(
                    "[Orange Belt] API tạm lỗi, retry:",
                    path,
                    statusCode,
                    apiError,
                    "| attempt:",
                    attempt
                )
            else
                warn(
                    "[Orange Belt] Phản hồi không hợp lệ:",
                    path,
                    statusCode,
                    tostring(responseBody)
                )
            end
        else
            warn(
                "[Orange Belt] HTTP lỗi:",
                path,
                "| attempt:",
                attempt,
                tostring(response)
            )
        end

        orangeHttpFailures = orangeHttpFailures + 1

        if orangeHttpFailures >= ORANGE_CIRCUIT_FAIL_LIMIT then
            orangeCircuitOpenUntil =
                tick() + ORANGE_CIRCUIT_RESET_SECONDS

            warn(
                "[Orange Belt] API circuit open",
                ORANGE_CIRCUIT_RESET_SECONDS,
                "giây"
            )
            return finish({
                success = false,
                error = "api_circuit_open",
                retry_after = ORANGE_CIRCUIT_RESET_SECONDS,
            })
        end

        local backoff = math.min(
            4,
            0.5 * (2 ^ (attempt - 1))
        )
        task.wait(backoff + math.random() * 0.35)
    end

    return finish(nil)
end

