getgenv().OrangeHopLowestServer = function()
    local httpRequest = getHttpRequest()
    if type(httpRequest) ~= "function" then
        warn("[Orange Belt] Không thể lấy server list: thiếu HTTP request.")
        return false
    end

    if getgenv().DracoFlowUI then
        getgenv().DracoFlowUI:SetStatus("SERVER FULL")
        getgenv().DracoFlowUI:SetSubStatus(
            "Hết cặp điểm drop, đang tìm public server ít người nhất"
        )
    end

    local candidates = {}
    local cursor = nil

    for page = 1, ORANGE_SERVER_LIST_PAGES do
        local url =
            "https://games.roblox.com/v1/games/"
            .. tostring(game.PlaceId)
            .. "/servers/Public?sortOrder=Asc&excludeFullGames=true&limit="
            .. tostring(ORANGE_SERVER_LIST_LIMIT)

        if cursor and cursor ~= "" then
            url = url .. "&cursor=" .. HttpService:UrlEncode(cursor)
        end

        local ok, response = pcall(function()
            return httpRequest({
                Url = url,
                Method = "GET",
                Headers = {
                    ["Content-Type"] = "application/json",
                },
            })
        end)

        if not ok or not response then
            warn("[Orange Belt] Lấy public server thất bại:", response)
            break
        end

        local body = response.Body or response.body or ""
        local decodeOk, decoded = pcall(function()
            return HttpService:JSONDecode(body)
        end)

        if not decodeOk or type(decoded) ~= "table" then
            warn("[Orange Belt] Server list JSON không hợp lệ.")
            break
        end

        for _, server in ipairs(decoded.data or {}) do
            local id = tostring(server.id or "")
            local playing = tonumber(server.playing) or math.huge
            local maxPlayers = tonumber(server.maxPlayers) or 0

            if id ~= ""
                and id ~= game.JobId
                and playing < maxPlayers
                and playing < 8 then
                table.insert(candidates, {
                    id = id,
                    playing = playing,
                    maxPlayers = maxPlayers,
                })
            end
        end

        cursor = decoded.nextPageCursor
        if not cursor or cursor == "" then
            break
        end
    end

    if #candidates == 0 then
        warn("[Orange Belt] Không tìm thấy public server còn chỗ.")
        task.wait(ORANGE_HOP_RETRY_DELAY)
        return false
    end

    table.sort(candidates, function(a, b)
        if a.playing == b.playing then
            return a.id < b.id
        end
        return a.playing < b.playing
    end)

    -- Cả hai acc trong cùng tenant luôn ưu tiên cùng server ít người nhất.
    -- Không chia theo UserId vì sẽ làm requester/helper bị tách sang hai JobId.
    local selectedIndex = 1
    local selected = candidates[selectedIndex]

    warn(
        "[Orange Belt] Hop lowest server | JobId:",
        selected.id,
        "| players:",
        selected.playing,
        "/",
        selected.maxPlayers,
        "| rank:",
        selectedIndex
    )

    orangeSessionActive = false
    orangeTeleporting = true
    orangeHeartbeat("hopping_low_player_" .. tostring(selected.playing))

    local serverBrowser = ReplicatedStorage:FindFirstChild("__ServerBrowser")
        or ReplicatedStorage:WaitForChild("__ServerBrowser", 10)

    if not serverBrowser then
        orangeTeleporting = false
        warn("[Orange Belt] Không tìm thấy __ServerBrowser để hop.")
        return false
    end

    local hopOk, hopResult = pcall(function()
        return serverBrowser:InvokeServer("teleport", selected.id)
    end)

    if not hopOk then
        orangeTeleporting = false
        warn("[Orange Belt] Hop lowest server lỗi:", hopResult)
        return false
    end

    return true
end

local function orangeRecoverFromDeadJoin(reason, failedJobId)
    if orangeJoinRecoveryBusy then
        return
    end

    orangeJoinRecoveryBusy = true
    orangeTeleporting = false
    orangeSessionActive = false

    warn(
        "[Orange Belt] JobId không join được, reset pair:",
        tostring(failedJobId),
        "| reason:",
        tostring(reason)
    )

    orangeSetStatus(
        "ORANGE BELT • DEAD SERVER",
        "JobId cũ không vào được, đang hủy pair và tìm low player"
    )

    -- Hủy session cũ để requester/helper không tiếp tục giữ JobId chết.
    pcall(function()
        orangeCancel(reason or "helper_join_failed")
    end)

    task.wait(0.8)

    orangeJoinFailureCount = 0
    orangeJoinFailureTarget = nil
    orangeLastJoinTarget = nil

    local hopped = false
    if getgenv().OrangeHopLowestServer then
        hopped = getgenv().OrangeHopLowestServer() == true
    end

    if not hopped then
        warn("[Orange Belt] Chưa hop được low player; vòng chính sẽ thử lại.")
        orangeTeleporting = false
    end

    task.delay(3, function()
        orangeJoinRecoveryBusy = false
    end)
end

local function orangeJoinJob(placeId, jobId)
    local requestedJobId = tostring(jobId or "")

    if requestedJobId == "" or requestedJobId == "nil" then
        warn("[Orange Belt] Không có JobId hợp lệ để join.")
        return false
    end

    if game.JobId == requestedJobId then
        orangeTeleporting = false
        orangeLastJoinTarget = requestedJobId
        orangeJoinFailureTarget = nil
        orangeJoinFailureCount = 0
        return true
    end

    if orangeJoinFailureTarget ~= requestedJobId then
        orangeJoinFailureTarget = requestedJobId
        orangeJoinFailureCount = 0
    end

    orangeJoinAttemptToken += 1
    local myToken = orangeJoinAttemptToken
    orangeLastJoinTarget = requestedJobId
    orangeTeleporting = true
    orangeHeartbeat("joining_requester")

    if getgenv().DracoFlowUI then
        getgenv().DracoFlowUI:SetStatus("JOIN REQUESTER")
        getgenv().DracoFlowUI:SetSubStatus(
            "Đang join JobId requester"
            .. "\n" .. string.sub(requestedJobId, 1, 22) .. "..."
            .. "\nFail: " .. tostring(orangeJoinFailureCount)
                .. "/" .. tostring(ORANGE_JOIN_MAX_FAILURES)
        )
    end

    warn(
        "[Orange Belt] Join target mới | current:",
        game.JobId,
        "| target:",
        requestedJobId,
        "| token:",
        myToken,
        "| fail:",
        orangeJoinFailureCount,
        "/",
        ORANGE_JOIN_MAX_FAILURES
    )

    local serverBrowser = ReplicatedStorage:FindFirstChild("__ServerBrowser")
        or ReplicatedStorage:WaitForChild("__ServerBrowser", 10)

    if not serverBrowser then
        orangeTeleporting = false
        orangeHeartbeat("join_failed_no_browser")
        orangeJoinFailureCount += 1

        if orangeJoinFailureCount >= ORANGE_JOIN_MAX_FAILURES then
            task.spawn(orangeRecoverFromDeadJoin, "missing_server_browser", requestedJobId)
        end
        return false
    end

    local oldJobId = game.JobId
    local ok, result = pcall(function()
        return serverBrowser:InvokeServer("teleport", requestedJobId)
    end)

    warn("[Orange Belt] Join result:", result)

    if not ok then
        orangeTeleporting = false
        orangeHeartbeat("join_remote_error")
        orangeJoinFailureCount += 1
        warn("[Orange Belt] Join lỗi:", result)

        if orangeJoinFailureCount >= ORANGE_JOIN_MAX_FAILURES then
            task.spawn(orangeRecoverFromDeadJoin, "join_remote_error", requestedJobId)
        end
        return false
    end

    -- InvokeServer thường trả nil kể cả khi request teleport đã được gửi.
    -- Xác nhận bằng JobId sau ORANGE_JOIN_VERIFY_SECONDS.
    task.delay(ORANGE_JOIN_VERIFY_SECONDS, function()
        if myToken ~= orangeJoinAttemptToken then
            return
        end

        if game.JobId == requestedJobId then
            orangeTeleporting = false
            orangeJoinFailureCount = 0
            orangeJoinFailureTarget = nil
            orangeHeartbeat("joined_requester")
            return
        end

        if game.JobId == oldJobId then
            orangeTeleporting = false
            orangeJoinFailureCount += 1
            orangeHeartbeat("join_verify_failed")

            warn(
                "[Orange Belt] Không đổi JobId | fail:",
                orangeJoinFailureCount,
                "/",
                ORANGE_JOIN_MAX_FAILURES,
                "| target:",
                requestedJobId
            )

            if orangeJoinFailureCount >= ORANGE_JOIN_MAX_FAILURES then
                task.spawn(
                    orangeRecoverFromDeadJoin,
                    "join_verify_failed",
                    requestedJobId
                )
            else
                warn(
                    "[Orange Belt] Sẽ thử lại JobId; quá giới hạn sẽ hủy pair và hop low player."
                )
            end
        end
    end)

    return true
end

--==================================================
-- AUTO REMOVE FRUIT WHEN RECEIVER CAPACITY IS FULL
-- Cảnh báo: LoadFruit + reset sẽ làm mất fruit đã lấy ra.
--==================================================
ORANGE_DUPLICATE_RESET_ENABLED = true
ORANGE_DUPLICATE_RESET_MAX = 5
orangeDuplicateResetCount = 0
orangeHandledCapacityFruits = {}

local function normalizeTradeFruitName(value)
    local name = tostring(value or "")
    name = name:gsub('^%s+', ''):gsub('%s+$', '')
    return name
end

local function getCapacityBlockedFruitName()
    local pg = plr:FindFirstChild("PlayerGui")
    if not pg then
        return nil
    end

    for _, object in ipairs(pg:GetDescendants()) do
        if object:IsA("TextLabel")
            or object:IsA("TextButton")
            or object:IsA("TextBox") then
            local original = tostring(object.Text or "")
            local lower = string.lower(original)

            if string.find(lower, "cannot receive", 1, true)
                and string.find(lower, "fruit capacity", 1, true) then
                local quoted = original:match('"([^"]+)"')
                if quoted and quoted ~= "" then
                    return normalizeTradeFruitName(quoted)
                end
            end
        end
    end

    return nil
end

local function findStoredFruitByDisplayName(displayName)
    local target = string.lower(normalizeTradeFruitName(displayName))

    local ok, inventory = pcall(function()
        return rem:InvokeServer("getInventory")
    end)

    if not ok or type(inventory) ~= "table" then
        return nil
    end

    for _, item in pairs(inventory) do
        if type(item) == "table"
            and tostring(item.Type) == "Blox Fruit" then
            local shown = string.lower(tostring(item.DisplayName or ""))
            local internal = tostring(item.Name or "")
            local internalSimple = string.lower(internal:gsub('%-.*$', ''))

            if shown == target or internalSimple == target then
                return {
                    DisplayName = tostring(item.DisplayName or displayName),
                    InternalName = internal ~= "" and internal
                        or (displayName .. "-" .. displayName),
                    ItemId = tonumber(item.ItemId),
                    Count = tonumber(item.Count) or 0,
                }
            end
        end
    end

    return nil
end

local function resetAfterLoadingFruit(fruit)
    if not fruit or fruit.InternalName == "" then
        return false
    end

    if orangeDuplicateResetCount >= ORANGE_DUPLICATE_RESET_MAX then
        warn("[AUTO TRADE] Đã đạt giới hạn reset fruit trùng.")
        return false
    end

    orangeDuplicateResetCount += 1

    warn(
        "[AUTO TRADE] Receiver đầy capacity, LoadFruit rồi reset:",
        fruit.InternalName,
        "| lần:",
        orangeDuplicateResetCount
    )

    local loadedOk, loadedResult = pcall(function()
        return rem:InvokeServer("LoadFruit", fruit.InternalName)
    end)

    if not loadedOk then
        warn("[AUTO TRADE] LoadFruit lỗi:", loadedResult)
        return false
    end

    task.wait(1)

    local backpack = plr:FindFirstChildOfClass("Backpack")
    local character = plr.Character
    local loadedTool = (backpack and backpack:FindFirstChild(fruit.InternalName))
        or (character and character:FindFirstChild(fruit.InternalName))

    if not loadedTool then
        warn("[AUTO TRADE] Không thấy fruit sau LoadFruit:", fruit.InternalName)
        return false
    end

    orangeHeartbeat("reset_duplicate_fruit")

    local oldCharacter = plr.Character
    local humanoid = oldCharacter
        and oldCharacter:FindFirstChildOfClass("Humanoid")

    if not humanoid then
        return false
    end

    humanoid.Health = 0

    local newCharacter = plr.CharacterAdded:Wait()
    newCharacter:WaitForChild("HumanoidRootPart", 15)
    task.wait(2)

    warn("[AUTO TRADE] Đã reset để xóa fruit trùng:", fruit.DisplayName)
    return true
end

local function handleCapacityBlockedFruit()
    if not ORANGE_DUPLICATE_RESET_ENABLED then
        return false
    end

    local displayName = getCapacityBlockedFruitName()
    if not displayName or orangeHandledCapacityFruits[displayName] then
        return false
    end

    local fruit = findStoredFruitByDisplayName(displayName)
    if not fruit or fruit.Count <= 0 then
        return false
    end

    orangeHandledCapacityFruits[displayName] = true
    return resetAfterLoadingFruit(fruit)
end


--==================================================
-- AUTO TRADE COORDINATED BY PYTHON SERVER
-- Both accounts upload inventory; server removes duplicates one at a time,
-- then returns a rare/high-value combination within the 40% value rule.
--==================================================
OrangeTradeFunction = ReplicatedStorage
    :WaitForChild("Remotes")
    :WaitForChild("TradeFunction")

ORANGE_TRADE_OPEN_TIMEOUT = 20
ORANGE_TRADE_PLAN_TIMEOUT = 90
ORANGE_TRADE_ADD_DELAY = 0.55
orangeAutoTradeRunning = false
orangeAutoTradeFinished = false

orangeTradeGuiIsOpen = function()
    local pg = plr:FindFirstChild("PlayerGui")
    if not pg then return false end
    for _, object in ipairs(pg:GetDescendants()) do
        if object:IsA("TextLabel") or object:IsA("TextButton") then
            if string.find(string.lower(tostring(object.Text or "")), "treasure trade", 1, true) then
                return true
            end
        end
    end
    return false
end

local function orangeInventorySnapshot()
    local ok, inventory = pcall(function()
        return rem:InvokeServer("getInventory")
    end)
    if not ok or type(inventory) ~= "table" then
        warn("[AUTO TRADE] Không đọc được inventory:", inventory)
        return {}
    end

    local fruits = {}
    for _, item in pairs(inventory) do
        if type(item) == "table"
            and tostring(item.Type) == "Blox Fruit"
            and tonumber(item.ItemId)
            and tonumber(item.Count or 0) > 0 then
            table.insert(fruits, {
                name = tostring(item.DisplayName or item.Name or "Unknown"),
                internal_name = tostring(item.Name or ""),
                item_id = tonumber(item.ItemId),
                value = tonumber(item.Value) or 0,
                count = tonumber(item.Count) or 1,
            })
        end
    end
    return fruits
end

local function orangeFindFruit(snapshot, target)
    if type(target) ~= "table" then return nil end
    local targetId = tonumber(target.item_id)
    local targetName = string.lower(tostring(target.name or ""))
    for _, fruit in ipairs(snapshot) do
        if tonumber(fruit.item_id) == targetId
            or string.lower(tostring(fruit.name)) == targetName then
            return fruit
        end
    end
    return nil
end

-- Fruit trùng luôn được unstore/reset gần Dojo, không xử lý cạnh bàn trade.
-- Tách nhẹ vị trí theo ghế để nhiều cặp không chồng hoàn toàn lên nhau.
local function orangeGetDuplicateFarCFrame(seatIndex)
    seatIndex = tonumber(seatIndex) or 1
    local lane = ((seatIndex - 1) % 3) - 1
    return Config.DOJO_POS * CFrame.new(lane * 7, 5, 12)
end

local function orangeLeaveTradeSeat(seatIndex)
    seatIndex = tonumber(seatIndex)

    pcall(function()
        OrangeTradeFunction:InvokeServer("cancel")
    end)

    local _, hum = getCharacter()
    hum.Sit = false
    hum.Jump = true
    task.wait(0.35)

    local dojoResetTarget = orangeGetDuplicateFarCFrame(seatIndex)

    orangeSetStatus(
        "ORANGE BELT • RESET FRUIT",
        "Đang về gần Dojo để unstore và reset fruit trùng"
    )

    -- Đi thẳng về khu Dojo. Không còn chờ Trade GUI biến mất vì GUI ẩn
    -- có thể vẫn nằm trong PlayerGui và làm flow bị kẹt.
    local moved = toposition(dojoResetTarget)
    local _, currentHum, currentRoot = getCharacter()
    currentHum.Sit = false
    currentRoot.CFrame = dojoResetTarget
    task.wait(0.6)

    local distance = (currentRoot.Position - dojoResetTarget.Position).Magnitude
    if moved or distance <= 20 then
        orangeDuplicatePhaseOffSeat = true
        orangeDuplicatePhaseSeat = seatIndex
        orangeHeartbeat("duplicate_dojo_position_ready")

        warn(
            "[AUTO TRADE] Đã tới gần Dojo để reset fruit | ghế:",
            seatIndex,
            "| distance:",
            distance
        )

        return true
    end

    warn(
        "[AUTO TRADE] Không thể về gần Dojo để reset fruit | ghế:",
        seatIndex,
        "| moved:",
        moved,
        "| distance:",
        distance
    )

    return false
end

local function orangeReturnToAssignedSeat(seatIndex)
    seatIndex = tonumber(seatIndex)
    if not seatIndex then
        warn("[AUTO TRADE] Không có seat_index để quay lại.")
        return false
    end

    if getgenv().DracoFlowUI then
        getgenv().DracoFlowUI:SetStatus("RETURN TRADE SEAT")
        getgenv().DracoFlowUI:SetSubStatus(
            "Đã reset fruit, đang quay lại điểm drop " .. tostring(seatIndex)
        )
    end

    local ok = orangeGoSeat(seatIndex)
    if not ok then
        warn("[AUTO TRADE] Quay lại điểm drop thất bại:", seatIndex)
        return false
    end

    local started = tick()
    while not orangeTradeGuiIsOpen() and tick() - started < 20 do
        -- Hai acc có thể chưa đồng thời ngồi lại; cứ ép lại điểm drop định kỳ.
        if math.floor(tick() - started) % 3 == 0 then
            local physicalSeat = orangeFindNearestTradeSeat(ORANGE_SEATS[seatIndex])
            local _, hum, hrp = getCharacter()
            if physicalSeat and not hum.Sit then
                pcall(function()
                    physicalSeat:Sit(hum)
                end)
            elseif not physicalSeat and not hum.Sit then
                hrp.CFrame = ORANGE_SEATS[seatIndex] * CFrame.new(0, 1.25, 0)
            end
        end
        task.wait(0.4)
    end

    if not orangeTradeGuiIsOpen() then
        warn("[AUTO TRADE] Đã về điểm drop nhưng cửa sổ trade chưa mở.")
        return false
    end

    orangeReady()
    task.wait(0.5)
    return true
end

orangeDuplicateResetBusy = false
orangeDuplicateCycleCompleted = false
orangeDuplicateCycleFruit = nil
orangeDuplicateResetKey = nil
orangeDuplicateResetStartedAt = 0

local function orangeFindHeldFruitTool()
    local character = plr.Character
    local backpack = plr:FindFirstChildOfClass("Backpack")

    local function scan(container)
        if not container then
            return nil
        end

        for _, tool in ipairs(container:GetChildren()) do
            if tool:IsA("Tool") then
                local tooltip = string.lower(tostring(tool.ToolTip or ""))
                local name = string.lower(tostring(tool.Name or ""))

                if tooltip == "blox fruit"
                    or string.find(name, " fruit", 1, true)
                    or string.find(name, "-", 1, true) then
                    return tool
                end
            end
        end

        return nil
    end

    return scan(character) or scan(backpack)
end

local function orangeWaitUntilNoHeldFruit(timeout)
    local started = tick()
    while tick() - started < (tonumber(timeout) or 10) do
        if not orangeFindHeldFruitTool() then
            return true
        end
        task.wait(0.25)
    end
    return orangeFindHeldFruitTool() == nil
end

local function orangeNormalizeFruitName(value)
    local name = string.lower(tostring(value or ""))

    name = name:gsub("%-", " ")
    name = name:gsub(" fruit", "")
    name = name:gsub("%s+", " ")
    name = name:gsub("^%s+", "")
    name = name:gsub("%s+$", "")

    -- Buddha-Buddha -> Buddha
    local first, second = name:match("^([^%s]+)%s+([^%s]+)$")
    if first and second and first == second then
        name = first
    end

    return name
end

local function orangeLoadAndResetDuplicate(target)
    local targetKey = orangeNormalizeFruitName(
        type(target) == "table"
            and (target.internal_name or target.name)
            or target
    )

    -- Mỗi cycle chỉ được xóa đúng 1 fruit.
    if orangeDuplicateCycleCompleted then
        warn(
            "[AUTO TRADE] Cycle này đã xóa 1 fruit:",
            tostring(orangeDuplicateCycleFruit),
            "| không xóa thêm."
        )
        return false
    end

    -- Chặn nhiều coordinator cùng gọi LoadFruit/reset một lúc.
    if orangeDuplicateResetBusy then
        warn(
            "[AUTO TRADE] Reset duplicate đang chạy:",
            tostring(orangeDuplicateResetKey)
        )
        return false
    end

    -- Chặn cùng một fruit bị gọi lại quá nhanh sau respawn.
    if orangeDuplicateResetKey == targetKey
        and tick() - orangeDuplicateResetStartedAt < 8 then
        warn("[AUTO TRADE] Bỏ qua duplicate gọi lặp:", targetKey)
        return false
    end

    orangeDuplicateResetBusy = true
    orangeDuplicateResetKey = targetKey
    orangeDuplicateResetStartedAt = tick()

    local function finish(result)
        orangeDuplicateResetBusy = false
        return result
    end

    local stateBefore = orangeCheck()
    local playerState = stateBefore and stateBefore.player
    local seatIndex = playerState and tonumber(playerState.seat_index)

    local snapshot = orangeInventorySnapshot()
    local fruit = orangeFindFruit(snapshot, target)

    if not fruit then
        warn("[AUTO TRADE] Fruit trùng đã không còn trong inventory.")
        orangeResetTradeInventorySnapshot()
        orangePostTradeInventory(snapshot)
        return finish(true)
    end

    warn(
        "[AUTO TRADE] Chuẩn bị xóa fruit trùng:",
        fruit.name,
        fruit.internal_name,
        "| điểm drop:",
        seatIndex
    )

    orangeHeartbeat("remote_remove_duplicate_" .. tostring(fruit.name))

    -- Fruit trùng được xử lý gần Dojo: hủy trade, rời ghế, về Dojo rồi mới LoadFruit/reset.
    if not orangeLeaveTradeSeat(seatIndex) then
        warn(
            "[AUTO PRECHECK] Không về được Dojo trước khi xử lý fruit:",
            fruit.name
        )
        return finish(false)
    end

    local char = plr.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hum then
        return finish(false)
    end

    warn(
        "[AUTO PRECHECK] Đã tới gần Dojo, bắt đầu unstore/reset fruit trùng:",
        fruit.name
    )

    -- Nếu lần LoadFruit trước đã tạo fruit vật lý nhưng chưa reset,
    -- tuyệt đối không LoadFruit thêm lần nữa. Reset fruit đang cầm trước.
    local alreadyHeld = orangeFindHeldFruitTool()

    if alreadyHeld then
        warn(
            "[AUTO TRADE] Đã có fruit vật lý đang cầm:",
            alreadyHeld.Name,
            "| reset luôn, không gọi LoadFruit thêm."
        )
    else
        orangeHeartbeat("load_duplicate_" .. tostring(fruit.name))

        local ok, result = pcall(function()
            return rem:InvokeServer("LoadFruit", fruit.internal_name)
        end)

        if not ok then
            warn("[AUTO TRADE] LoadFruit lỗi:", result)
            orangeDuplicatePhaseOffSeat = true
            orangeDuplicatePhaseSeat = seatIndex
            return finish(false)
        end

        -- Chỉ gọi LoadFruit một lần rồi chờ tool xuất hiện.
        local loadedTool = nil
        local loadStarted = tick()

        while tick() - loadStarted < 6 do
            loadedTool = orangeFindHeldFruitTool()
            if loadedTool then
                break
            end
            task.wait(0.2)
        end

        if not loadedTool then
            warn(
                "[AUTO TRADE] LoadFruit chưa tạo fruit vật lý:",
                fruit.internal_name,
                "| result:",
                result
            )
            orangeDuplicatePhaseOffSeat = true
            orangeDuplicatePhaseSeat = seatIndex
            return finish(false)
        end

        warn("[AUTO TRADE] LoadFruit thành công:", loadedTool.Name)
    end

    orangeResetTradeInventorySnapshot()

    -- Reset đúng một lần.
    char = plr.Character
    hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hum then
        return finish(false)
    end

    warn("[AUTO TRADE] Reset để xóa fruit:", fruit.name)
    hum.Health = 0

    local newChar = plr.CharacterAdded:Wait()
    newChar:WaitForChild("HumanoidRootPart", 15)
    newChar:WaitForChild("Humanoid", 15)

    task.wait(1.5)

    -- Sau respawn luôn trở lại gần Dojo để tiếp tục precheck tại chỗ.
    -- Chưa được đi tới ghế cho tới khi server trả plan trade hợp lệ.
    local dojoResetTarget = orangeGetDuplicateFarCFrame(seatIndex)
    pcall(function()
        toposition(dojoResetTarget)
        local _, respawnHum, respawnRoot = getCharacter()
        respawnHum.Sit = false
        respawnRoot.CFrame = dojoResetTarget
    end)
    task.wait(0.5)

    -- Không quay lại điểm drop nếu fruit vật lý vẫn còn sau respawn.
    if not orangeWaitUntilNoHeldFruit(8) then
        warn("[AUTO TRADE] Fruit vật lý vẫn còn sau reset, thử reset thêm 1 lần.")

        local secondHum = newChar:FindFirstChildOfClass("Humanoid")
        if secondHum then
            secondHum.Health = 0
            newChar = plr.CharacterAdded:Wait()
            newChar:WaitForChild("HumanoidRootPart", 15)
            newChar:WaitForChild("Humanoid", 15)
            task.wait(1.5)
        end
    end

    if orangeFindHeldFruitTool() then
        warn("[AUTO TRADE] Không xóa được fruit vật lý, dừng vòng này.")
        return finish(false)
    end

    -- Gửi inventory mới khi vẫn đứng ngoài bàn.
    -- Khi server đổi plan, cả hai acc mới quay lại điểm drop cùng lúc.
    local refreshed = orangeInventorySnapshot()
    local posted = orangePostTradeInventory(refreshed)

    warn(
        "[AUTO TRADE] Đã reset và gửi inventory mới khi đứng ngoài điểm drop:",
        fruit.name,
        "| fruits:",
        #refreshed,
        "| posted:",
        posted ~= nil
    )

    orangeHeartbeat("inventory_refreshed_after_duplicate")

    -- Đánh dấu cycle này đã xóa đúng 1 fruit.
    orangeDuplicateCycleCompleted = true
    orangeDuplicateCycleFruit = fruit.name

    -- Không quay lại ghế tại đây.
    -- Cả hai acc phải tiếp tục đứng ngoài bàn cho tới khi server trả plan
    -- "trade" mới. Khi đó cả hai cùng chạy orangeExitDuplicateWaitPhase()
    -- và loop ngồi lại đúng ghế.
    orangeDuplicatePhaseOffSeat = true
    orangeDuplicatePhaseSeat = seatIndex
    orangeAutoTradeFinished = false

    return finish(posted ~= nil)
end


local function orangeNormalizeVisibleFruitName(value)
    local name = string.lower(tostring(value or ""))
    name = name:gsub("%-", " ")
    name = name:gsub(" fruit", "")
    name = name:gsub("%s+", " ")
    name = name:gsub("^%s+", ""):gsub("%s+$", "")
    return name
end

local function orangeTradeGuiHasFruit(fruitName)
    local wanted = orangeNormalizeVisibleFruitName(fruitName)
    if wanted == "" then
        return false
    end

    local pg = plr:FindFirstChild("PlayerGui")
    if not pg then
        return false
    end

    for _, object in ipairs(pg:GetDescendants()) do
        if object:IsA("TextLabel")
            or object:IsA("TextButton")
            or object:IsA("TextBox") then
            local shown = orangeNormalizeVisibleFruitName(object.Text)
            if shown == wanted then
                return true
            end
        end
    end

    return false
end

local function orangeWaitTradeGuiFruit(fruitName, timeout)
    local started = tick()
    while tick() - started < (tonumber(timeout) or 4) do
        if not orangeTradeGuiIsOpen() then
            return false
        end
        if orangeTradeGuiHasFruit(fruitName) then
            return true
        end
        task.wait(0.15)
    end
    return orangeTradeGuiHasFruit(fruitName)
end

local function orangeCancelAndClearTrade()
    pcall(function()
        OrangeTradeFunction:InvokeServer("cancel")
    end)

    local started = tick()
    while orangeTradeGuiIsOpen() and tick() - started < 6 do
        task.wait(0.2)
    end
end

local function orangeAddPlannedItems(items)
    if type(items) ~= "table" or #items == 0 then
        return false
    end

    if not orangeTradeGuiIsOpen() then
        warn("[AUTO TRADE] Không addItem vì Trade GUI chưa mở.")
        return false
    end

    for _, fruit in ipairs(items) do
        local ok, result = pcall(function()
            return OrangeTradeFunction:InvokeServer(
                "addItem",
                tonumber(fruit.item_id),
                1
            )
        end)

        local serverAccepted = ok and result == true
        local guiConfirmed = false

        if serverAccepted then
            guiConfirmed = orangeWaitTradeGuiFruit(
                fruit.name,
                4
            )
        end

        warn(
            "[AUTO TRADE] planned addItem:",
            tostring(fruit.name),
            "| ItemId:", tostring(fruit.item_id),
            "| Value:", tostring(fruit.value),
            "| RemoteOK:", ok,
            "| Result:", result,
            "| GUI confirmed:", guiConfirmed
        )

        if not serverAccepted or not guiConfirmed then
            warn(
                "[AUTO TRADE] addItem sai/không hiện đúng fruit; hủy trade để loop lại:",
                tostring(fruit.name)
            )
            orangeCancelAndClearTrade()
            return false
        end

        task.wait(ORANGE_TRADE_ADD_DELAY)
    end

    return true
end

local function orangeAcceptTrade()
    if not orangeTradeGuiIsOpen() then
        warn("[AUTO TRADE] Không accept vì Trade GUI đã đóng.")
        return false
    end

    local ok, result = pcall(function()
        return OrangeTradeFunction:InvokeServer("accept")
    end)

    local accepted = ok and result ~= false
    warn("[AUTO TRADE] accept:", ok, result, "| accepted:", accepted)
    return accepted
end

orangeDuplicatePhaseOffSeat = false
orangeDuplicatePhaseSeat = nil
orangeDuplicatePhaseFruit = nil

local function orangeEnterDuplicateWaitPhase(plan)
    local checkData = orangeCheck()
    local currentPlayer = checkData and checkData.player
    local seatIndex = currentPlayer and tonumber(currentPlayer.seat_index)

    orangeDuplicatePhaseSeat = seatIndex
    orangeDuplicatePhaseFruit =
        plan and plan.fruit and tostring(plan.fruit.name or "?") or "?"

    if orangeDuplicatePhaseOffSeat then
        return true
    end

    warn(
        "[AUTO TRADE] Duplicate phase: rời điểm drop | fruit:",
        orangeDuplicatePhaseFruit,
        "| no-seat:",
        seatIndex
    )

    pcall(function()
        OrangeTradeFunction:InvokeServer("cancel")
    end)

    if not orangeLeaveTradeSeat(seatIndex) then
        warn("[AUTO TRADE] Không thể rời xa ghế trong duplicate phase.")
        return false
    end

    local started = tick()
    while orangeTradeGuiIsOpen() and tick() - started < 8 do
        local _, hum = getCharacter()
        hum.Sit = false
        task.wait(0.25)
    end

    orangeDuplicatePhaseOffSeat = true
    orangeHeartbeat("duplicate_phase_off_seat")
    return true
end

local function orangeExitDuplicateWaitPhase()
    if not orangeDuplicatePhaseOffSeat then
        return true
    end

    local seatIndex = orangeDuplicatePhaseSeat
    orangeDuplicatePhaseOffSeat = false
    orangeDuplicatePhaseFruit = nil

    if not seatIndex then
        return false
    end

    warn("[AUTO TRADE] Duplicate phase hoàn tất, quay lại điểm drop:", seatIndex)
    return orangeReturnToAssignedSeat(seatIndex)
end


local function orangePrecheckInventoriesBeforeSeat(seatIndex)
    seatIndex = tonumber(seatIndex)
    if not seatIndex then
        warn("[AUTO PRECHECK] Thiếu seat_index.")
        return false
    end

    if getgenv().DracoFlowUI then
        getgenv().DracoFlowUI:SetStatus("CHECK BOTH INVENTORIES")
        getgenv().DracoFlowUI:SetSubStatus(
            "Hai acc đã request Dojo, đứng gần Dojo để kiểm tra fruit trước khi trade"
        )
    end

    -- Hai acc đứng gần Dojo; tuyệt đối chưa vào ghế trong giai đoạn này.
    orangeDuplicatePhaseOffSeat = true
    orangeDuplicatePhaseSeat = seatIndex

    local firstSnapshot = orangeInventorySnapshot()
    local submitted = orangePostTradeInventory(firstSnapshot)
    if not submitted then
        warn("[AUTO PRECHECK] Không gửi được inventory ban đầu.")
        return false
    end

    local started = tick()
    local lastInventoryPostAt = tick()
    local lastResetRetryAt = 0
    local confirmedTradeOnce = false

    while tick() - started < ORANGE_TRADE_PLAN_TIMEOUT do
        local response = orangeGetTradePlan()

        if response
            and response.success == false
            and tostring(response.error or "") == "session_not_found" then
            orangeRecoverMissingSession("inventory_precheck")
            return false
        end

        local plan = response and response.plan
        local action = plan and tostring(plan.action or "") or ""

        warn(
            "[AUTO PRECHECK] plan:",
            action ~= "" and action or "no_response",
            "| target:",
            tostring(plan and plan.username or "-"),
            "| fruit:",
            tostring(plan and plan.fruit and plan.fruit.name or "-")
        )

        if action == "waiting_helper" or action == "waiting_inventory" or action == "" then
            if tick() - lastInventoryPostAt >= 2 then
                lastInventoryPostAt = tick()
                orangePostTradeInventory(orangeInventorySnapshot())
            end

        elseif action == "remove_duplicate" then
            confirmedTradeOnce = false

            local targetUsername =
                string.lower(tostring(plan.username or ""))
            local myUsername =
                string.lower(tostring(plr.Name or ""))

            if getgenv().DracoFlowUI then
                getgenv().DracoFlowUI:SetStatus("REMOVE DUPLICATE BEFORE TRADE")
                getgenv().DracoFlowUI:SetSubStatus(
                    targetUsername == myUsername
                    and (
                        "Acc này đang giữ fruit làm bên kia không nhận được; "
                        .. "unstore từ xa rồi reset: "
                        .. tostring(plan.fruit and plan.fruit.name or "?")
                    )
                    or (
                        "Đang chờ acc kia reset: "
                        .. tostring(plan.fruit and plan.fruit.name or "?")
                    )
                )
            end

            if targetUsername == myUsername
                and not orangeDuplicateResetBusy
                and tick() - lastResetRetryAt >= 2 then

                lastResetRetryAt = tick()

                local requestedFruit = orangeNormalizeFruitName(
                    plan.fruit and (
                        plan.fruit.internal_name
                        or plan.fruit.name
                    )
                )
                local previousFruit = orangeNormalizeFruitName(
                    orangeDuplicateCycleFruit or ""
                )

                -- Server chỉ trả remove_duplicate khi không tìm được plan trade.
                -- Khi server chuyển sang một fruit trùng mới, mở khóa để xử lý
                -- tiếp fruit đó. Nếu đã có plan trade thì nhánh này không chạy.
                if requestedFruit ~= ""
                    and requestedFruit ~= previousFruit then
                    orangeDuplicateCycleCompleted = false
                    orangeDuplicateResetKey = nil
                end

                if not orangeDuplicateCycleCompleted then
                    local removed =
                        orangeLoadAndResetDuplicate(plan.fruit)

                    if not removed then
                        warn(
                            "[AUTO PRECHECK] Reset fruit trùng chưa thành công, sẽ thử lại:",
                            requestedFruit
                        )
                    end
                else
                    orangePostTradeInventory(orangeInventorySnapshot())
                end
            end

        elseif action == "trade" then
            -- Xác nhận inventory thêm một lần ngay trước khi cho cả hai vào ghế.
            if not confirmedTradeOnce then
                confirmedTradeOnce = true
                orangeDuplicateCycleCompleted = false
                orangeDuplicateCycleFruit = nil

                local verifySnapshot = orangeInventorySnapshot()
                orangePostTradeInventory(verifySnapshot)
                task.wait(0.8)
            else
                local verifyResponse = orangeGetTradePlan()

                if verifyResponse
                    and verifyResponse.success == false
                    and tostring(verifyResponse.error or "") == "session_not_found" then
                    orangeRecoverMissingSession("inventory_verify")
                    return false
                end

                local verifyPlan = verifyResponse and verifyResponse.plan
                local verifyAction =
                    verifyPlan and tostring(verifyPlan.action or "") or ""

                if verifyAction == "trade"
                    and verifyPlan.verified == true
                    and verifyPlan.receiver_capacity_checked == true then

                    orangeDuplicatePhaseFruit = nil
                    orangeDuplicateCycleCompleted = false
                    orangeDuplicateCycleFruit = nil

                    orangeHeartbeat("inventory_precheck_verified")

                    warn(
                        "[AUTO PRECHECK] Inventory 2 acc đã verify: "
                        .. "không lỗi receive-capacity, tỷ lệ hợp lệ. "
                        .. "Bắt đầu func trade và di chuyển tới ghế."
                    )

                    -- Precheck chỉ kiểm tra/reset fruit gần Dojo.
                    -- Không tự quay lại ghế tại đây; orangeResumeSession sẽ
                    -- gọi orangeGoSeat đúng một lần rồi mới bắt đầu trade.
                    orangeDuplicatePhaseOffSeat = false
                    orangeDuplicatePhaseSeat = nil

                    return true
                end

                confirmedTradeOnce = false
            end

        elseif action == "no_balanced_pair" then
            warn(
                "[AUTO PRECHECK] Không có tổ hợp fruit nào đủ tỷ lệ trade."
            )
            return false
        end

        task.wait(0.65)
    end

    warn("[AUTO PRECHECK] Hết thời gian kiểm tra inventory 2 acc.")
    return false
end


orangeTradeCompletedSignal = false

local function orangeTradeCompletionVisible()
