local function orangeFindNearestTradeSeat(targetCFrame)
    local bestSeat = nil
    local bestDistance = math.huge

    for _, object in ipairs(Workspace:GetDescendants()) do
        if object:IsA("Seat") or object:IsA("VehicleSeat") then
            local distance = (object.Position - targetCFrame.Position).Magnitude
            if distance <= 18 and distance < bestDistance then
                bestSeat = object
                bestDistance = distance
            end
        end
    end

    return bestSeat
end

local function orangeGoSeat(seatIndex)
    seatIndex = tonumber(seatIndex)

    if type(ORANGE_SEATS) ~= "table" then
        warn("[Orange Belt] ORANGE_SEATS chưa được khởi tạo.")
        return false
    end

    local seatCFrame = seatIndex and ORANGE_SEATS[seatIndex] or nil
    if not seatCFrame then
        warn("[Orange Belt] Ghế không hợp lệ:", seatIndex)
        return false
    end

    orangeSetStatus(
        "ORANGE BELT • GO TRADE SEAT",
        "Đang di chuyển tới ghế " .. tostring(seatIndex)
    )

    if getgenv().DracoFlowUI then
        getgenv().DracoFlowUI:SetStatus(
            "ORANGE BELT • GO TRADE SEAT"
        )
        getgenv().DracoFlowUI:SetSubStatus(
            "Đang tới ghế trade " .. tostring(seatIndex)
        )
    end

    local seated = false

    for attempt = 1, 10 do
        local char, hum, hrp = getCharacter()

        hum.Sit = false
        toposition(seatCFrame * CFrame.new(0, 2, 0))
        task.wait(0.35)

        local physicalSeat = orangeFindNearestTradeSeat(seatCFrame)
        if physicalSeat then
            pcall(function()
                physicalSeat:Sit(hum)
            end)
        else
            -- Fallback: đặt sát mặt ghế để game tự nhận ngồi.
            hrp.CFrame = seatCFrame * CFrame.new(0, 1.25, 0)
        end

        task.wait(0.55)

        if hum.Sit or orangeTradeGuiIsOpen() then
            seated = true
            break
        end

        warn(
            "[AUTO TRADE] Chưa ngồi được điểm drop",
            seatIndex,
            "| thử:",
            attempt
        )
    end

    if not seated then
        warn("[AUTO TRADE] Không thể ngồi lại điểm drop:", seatIndex)
        return false
    end

    local ready = orangeReady()
    if not ready or ready.success ~= true then
        warn("[AUTO TRADE] Gửi ready lại thất bại.")
        return false
    end

    return true
end

