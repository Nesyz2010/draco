local function normalizeItemName(value)
    local name = string.lower(tostring(value or ""))
    name = string.gsub(name, "[%(%)]", "")
    name = string.gsub(name, "[%s_%-]+", "")
    return name
end

local function isOrangeBeltName(value)
    local name = normalizeItemName(value)
    return name == "orangebelt"
        or name == "dojobeltorange"
end

local function hasBelt(beltName)
    if tostring(beltName) ~= "Orange Belt" then
        return false
    end

    local ok, inventory = pcall(function()
        return rem:InvokeServer("getInventory")
    end)

    if ok and type(inventory) == "table" then
        for _, item in pairs(inventory) do
            if type(item) == "table" then
                local actualName =
                    item.Name
                    or item.ItemName
                    or item.DisplayName
                    or item.name

                if isOrangeBeltName(actualName) then
                    return true
                end
            elseif type(item) == "string"
                and isOrangeBeltName(item) then
                return true
            end
        end
    end

    local function scan(container)
        if not container then
            return false
        end

        for _, object in ipairs(container:GetChildren()) do
            if isOrangeBeltName(object.Name) then
                return true
            end
        end

        return false
    end

    return scan(plr:FindFirstChildOfClass("Backpack"))
        or scan(plr.Character)
end


