--==============================================================
-- REQUESTER LOW-PLAYER SERVER
-- Only requester uses this. Helper waits for the requester's JobId.
--==============================================================
local function blueHopLowestServer()
    local httpRequest = getHttpRequest()

    if type(httpRequest) ~= "function" then
        warn("[Blue Belt] Không thể lấy server list: thiếu HTTP request.")
        return false
    end

    if getgenv().DracoFlowUI then
        getgenv().DracoFlowUI:SetStatus(
            "BLUE BELT • FIND LOW SERVER"
        )
        getgenv().DracoFlowUI:SetSubStatus(
            "Requester đang tìm public server ít người"
        )
    end

    local candidates = {}
    local cursor = nil

    for _ = 1, Config.BLUE_SERVER_LIST_PAGES do
        local url =
            "https://games.roblox.com/v1/games/"
            .. tostring(game.PlaceId)
            .. "/servers/Public?sortOrder=Asc&excludeFullGames=true&limit="
            .. tostring(Config.BLUE_SERVER_LIST_LIMIT)

        if cursor and cursor ~= "" then
            url = url
                .. "&cursor="
                .. HttpService:UrlEncode(cursor)
        end

        local ok, response = pcall(function()
            return httpRequest({
                Url = url,
                Method = "GET",
                Headers = {
                    ["Content-Type"] = "application/json",
                },
                Timeout = 12,
            })
        end)

        if not ok or not response then
            warn("[Blue Belt] Lấy server list thất bại:", response)
            break
        end

        local body = response.Body or response.body or ""
        local decodedOk, decoded = pcall(function()
            return HttpService:JSONDecode(body)
        end)

        if not decodedOk or type(decoded) ~= "table" then
            warn("[Blue Belt] Server list JSON không hợp lệ.")
            break
        end

        for _, server in ipairs(decoded.data or {}) do
            local id = tostring(server.id or "")
            local playing = tonumber(server.playing) or math.huge
            local maxPlayers = tonumber(server.maxPlayers) or 0

            if id ~= ""
                and id ~= game.JobId
                and playing < maxPlayers
                and playing <= Config.BLUE_MAX_PUBLIC_PLAYERS then

                table.insert(candidates, {
                    id = id,
                    playing = playing,
                    maxPlayers = maxPlayers,
                })
            end
        end

        cursor = decoded.nextPageCursor
        if not cursor or cursor == "" then
            break
        end
    end

    if #candidates == 0 then
        warn("[Blue Belt] Không tìm thấy low-player server.")
        task.wait(Config.BLUE_HOP_RETRY_DELAY)
        return false
    end

    table.sort(candidates, function(a, b)
        if a.playing == b.playing then
            return a.id < b.id
        end
        return a.playing < b.playing
    end)

    -- Always select the same lowest server. Only requester calls this.
    local selected = candidates[1]

    warn(
        "[Blue Belt] Requester hop low server | JobId:",
        selected.id,
        "| players:",
        selected.playing,
        "/",
        selected.maxPlayers
    )

    blueHeartbeat("blue_requester_hopping_low")

    local serverBrowser =
        ReplicatedStorage:FindFirstChild("__ServerBrowser")
        or ReplicatedStorage:WaitForChild("__ServerBrowser", 10)

    if not serverBrowser then
        warn("[Blue Belt] Không tìm thấy __ServerBrowser.")
        return false
    end

    getgenv().BlueRequesterHopTarget = selected.id
    getgenv().BlueRequesterHopAt = tick()

    local hopOk, hopResult = pcall(function()
        return serverBrowser:InvokeServer(
            "teleport",
            selected.id
        )
    end)

    warn(
        "[Blue Belt] Requester hop result:",
        hopOk,
        hopResult
    )

    return hopOk
end

getgenv().BlueHopLowestServer = blueHopLowestServer

