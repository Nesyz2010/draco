local function getCharacter()
    local character = plr.Character or plr.CharacterAdded:Wait()
    local humanoid = character:WaitForChild("Humanoid")
    local root = character:WaitForChild("HumanoidRootPart")
    return character, humanoid, root
end

local function toposition(pos)
    if typeof(pos) ~= "CFrame" then
        return false
    end

    local character, humanoid, hrp = getCharacter()

    humanoid.Sit = false

    for _, part in ipairs(character:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = false
        end
    end

    local tweenRoot = character:FindFirstChild("Root")

    if not tweenRoot then
        tweenRoot = Instance.new("Part")
        tweenRoot.Name = "Root"
        tweenRoot.Size = Vector3.new(20, 0.5, 20)
        tweenRoot.Anchored = true
        tweenRoot.Transparency = 1
        tweenRoot.CanCollide = false
        tweenRoot.CFrame = hrp.CFrame
        tweenRoot.Parent = character
    end

    tweenRoot.CFrame = hrp.CFrame

    local distance = (pos.Position - hrp.Position).Magnitude

    if distance <= 10 then
        tweenRoot.CFrame = pos
        hrp.CFrame = pos
        return true
    end

    if activeTween then
        pcall(function()
            activeTween:Cancel()
        end)
    end

    activeTween = TweenService:Create(
        tweenRoot,
        TweenInfo.new(
            distance / Config.SPEED,
            Enum.EasingStyle.Linear
        ),
        {CFrame = pos}
    )

    activeTween:Play()

    while activeTween.PlaybackState
        == Enum.PlaybackState.Playing do

        if not hrp.Parent or not tweenRoot.Parent then
            return false
        end

        hrp.CFrame = tweenRoot.CFrame
        task.wait()
    end

    hrp.CFrame = tweenRoot.CFrame
    return true
end

