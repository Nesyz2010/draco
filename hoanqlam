    end

    for _, object in ipairs(pg:GetDescendants()) do
        if object:IsA("TextLabel")
            or object:IsA("TextButton")
            or object:IsA("TextBox") then
            local value = string.lower(tostring(object.Text or ""))
            if string.find(value, "trade completed", 1, true)
                or string.find(value, "check your inventory", 1, true)
                or string.find(value, "trade complete", 1, true) then
                return true
            end
        end
    end
    return false
end

local function orangeWaitTrade()
    if getgenv().DracoFlowUI then
        getgenv().DracoFlowUI:SetStatus("WAIT AUTO TRADE")
        getgenv().DracoFlowUI:SetSubStatus(
            "Inventory đã kiểm tra xong, hai acc đang thực hiện giao dịch"
        )
    end

    orangeAutoTradeFinished = false
    orangeAutoTradeRunning = false

    local function startCoordinatorIfNeeded()
        if orangeAutoTradeRunning or orangeAutoTradeFinished then
            return
        end

        task.spawn(function()
            local ok, err = pcall(orangeRunAutoTrade)
            if not ok then
                orangeAutoTradeRunning = false
                warn("[AUTO TRADE] Runtime error:", err)
            end
        end)
    end

    startCoordinatorIfNeeded()

    local started = tick()
    while tick() - started < ORANGE_TRADE_TIMEOUT do
        -- Quan trọng: remove_duplicate làm coordinator return.
        -- Sau respawn/quay lại điểm drop, tự chạy coordinator lại để trade tiếp tục.
        startCoordinatorIfNeeded()
        if orangeTradeCompletedSignal or screenHasTradeCompleted() then
            orangeTradeCompletedSignal = false
            warn("[Orange Belt] Trade đã hoàn tất, chờ server đồng bộ quest...")
            task.wait(2)
            orangeComplete()
            return true
        end

        -- Duplicate/capacity được Python coordinator xử lý trước khi add.
        -- Không cancel session ở đây vì sẽ làm flow dừng sau khi reset.

        local state = orangeCheck()
        local session = state and state.session
        local playerState = state and state.player

        if playerState and playerState.role == "helper" and session then
            local joinData = state.join
            local freshTarget = tostring(
                (joinData and joinData.job_id)
                or session.job_id
                or ""
            )

            if freshTarget ~= "" and game.JobId ~= freshTarget then
                warn(
                    "[Orange Belt] Phát hiện đang sai JobId trong lúc trade:",
                    game.JobId,
                    "->",
                    freshTarget
                )
                orangeAutoTradeRunning = false
                orangeJoinJob(
                    (joinData and joinData.place_id) or session.place_id,
                    freshTarget
                )
                return false
            end
        end

        if session then
            if session.status == "completed" then
                return true
            end
            if session.status == "failed"
                or session.status == "expired"
                or session.status == "cancelled" then
                warn("[Orange Belt] Session dừng:", session.status, session.error)
                return false
            end
        elseif state and state.success then
            return false
        end

        task.wait(ORANGE_CHECK_INTERVAL)
    end

    orangeCancel("trade_timeout")
    return false
end

local function orangeClaimAfterTrade()
    ensureReturnedToTikiBeforeDojo()

    if getgenv().DracoFlowUI then
        getgenv().DracoFlowUI:SetStatus("CLAIM ORANGE BELT")
        getgenv().DracoFlowUI:SetSubStatus(
            "Trade đã hoàn tất, đang nhận Orange Belt"
        )
    end

    -- Chờ server game ghi nhận trade hoàn tất vào quest.
    task.wait(3)

    toposition(Config.DOJO_POS)
    task.wait(0.8)

    local started = tick()
    local attempt = 0

    while tick() - started < 30 do
        if hasBelt("Orange Belt") then
            warn("[Orange Belt] Đã xác nhận có Orange Belt.")
            return true
        end

        attempt += 1

        local claimArgs = {
            [1] = {
                NPC = "Dojo Trainer",
                Command = "ClaimQuest",
            }
        }

        local ok, result = pcall(function()
            return DragonQuestRemote:InvokeServer(unpackArgs(claimArgs))
        end)

        warn(
            "[Orange Belt] Claim sau trade | lần:",
            attempt,
            "| ok:",
            ok,
            "| result:",
            result
        )

        task.wait(1.2)
    end

    warn("[Orange Belt] Hết thời gian claim nhưng chưa thấy Orange Belt.")
    return hasBelt("Orange Belt")
end

local function orangeFinishAndClaim()
    local claimed = orangeClaimAfterTrade()

    if claimed then
        orangeRelease()
        orangeSessionActive = false
        return true
    end

    -- Chưa nhận được belt thì giữ session/state để vòng sau thử claim lại,
    -- không request quest mới và không giải phóng quá sớm.
    orangeSessionActive = false
    return false
end

local function orangeResumeSession(state)
    local playerState = state and state.player
    local session = state and state.session

    if not playerState or not session then
        orangeSetStatus(
            "ORANGE BELT • WAIT PAIR",
            "Đã đăng ký API, đang chờ đủ requester/helper"
        )

        local started = tick()
        while tick() - started < 90 do
            local fresh = orangeCheck()
            local freshPlayer = fresh and fresh.player
            local freshSession = fresh and fresh.session

            if freshPlayer and freshSession then
                playerState = freshPlayer
                session = freshSession
                state = fresh
                break
            end

            -- Re-submit match so a waiting player can claim/create a pair.
            -- Handle HTTP 409/hop_required instead of endlessly spamming /api/match.
            local matchResult = orangeMatchRequest()

            if matchResult then
                if matchResult.success == true then
                    -- Match/create succeeded. /api/check will return the session
                    -- on the next loop iteration.
                    task.wait(0.5)

                elseif matchResult.hop_required == true then
                    local reason = tostring(
                        matchResult.error or "server_unavailable"
                    )

                    warn(
                        "[Orange Belt] Server hiện tại không thể tạo pair:",
                        reason
                    )

                    orangeSetStatus(
                        "ORANGE BELT • SERVER UNAVAILABLE",
                        reason == "server_player_limit"
                            and "Server quá đông, đang tìm server khác"
                            or "Server đã đủ pair, đang tìm server khác"
                    )

                    orangeSessionActive = false

                    if getgenv().OrangeHopLowestServer then
                        getgenv().OrangeHopLowestServer()
                    end

                    return false
                end
            end

            task.wait(1.5)
        end

        if not playerState or not session then
            warn("[Orange Belt] Hết thời gian chờ pair/session.")
            orangeSessionActive = false
            return false
        end
    end

    playerState.seat_index =
        tonumber(playerState.seat_index)
        or tonumber(session.seat_index)
        or tonumber(session.pair_slot)

    if session.status == "completed" then
        return orangeFinishAndClaim()
    end

    if session.status == "failed"
        or session.status == "expired"
        or session.status == "cancelled" then
        orangeRelease()
        orangeSessionActive = false
        return false
    end

    if playerState.role == "helper" then
        -- /api/check returns a fresh authoritative join target.
        local joinData = state.join
        local targetJobId = tostring(
            (joinData and joinData.job_id)
            or session.job_id
            or ""
        )
        local targetPlaceId =
            (joinData and joinData.place_id)
            or session.place_id

        if targetJobId ~= "" and game.JobId ~= targetJobId then
            orangeJoinJob(targetPlaceId, targetJobId)
            return false
        end
    end

    -- Cả requester và helper đều claim/request quest trước khi tới điểm drop.
    orangePrepareQuest()
    if hasBelt("Orange Belt") then
        orangeComplete()
        return orangeFinishAndClaim()
    end

    local seatIndex = tonumber(playerState.seat_index)
    if not seatIndex or not ORANGE_SEATS[seatIndex] then
        warn("[Orange Belt] Session thiếu seat_index hợp lệ.")
        orangeRelease()
        orangeSessionActive = false
        return false
    end

    -- Wait until both accounts are confirmed in the reserved JobId.
    orangeSetStatus(
        "ORANGE BELT • WAIT BOTH ACCOUNTS",
        "Đang chờ requester/helper vào cùng JobId"
    )

    local sameServerStarted = tick()
    while tick() - sameServerStarted < 75 do
        local fresh = orangeCheck()
        local freshSession = fresh and fresh.session
        local freshPlayer = fresh and fresh.player

        if freshSession and freshPlayer then
            local requesterReady =
                freshSession.requester_joined == true
                or freshSession.requester_ready == true
                or freshSession.requester_in_server == true

            local helperReady =
                freshSession.helper_joined == true
                or freshSession.helper_ready == true
                or freshSession.helper_in_server == true

            -- Fallback for servers that don't expose joined flags:
            -- continue once this client is in the reserved JobId and a helper exists.
            local helperExists =
                freshSession.helper ~= nil
                or freshSession.helper_username ~= nil
                or freshSession.helper_name ~= nil

            local reservedJob = tostring(freshSession.job_id or "")
            local inReservedJob =
                reservedJob == ""
                or game.JobId == reservedJob

            if inReservedJob and (
                (requesterReady and helperReady)
                or helperExists
            ) then
                break
            end
        end

        orangeHeartbeat("waiting_both_accounts")
        task.wait(1)
    end

    -- Check both inventories before either account sits down.
    orangeSetStatus(
        "ORANGE BELT • INVENTORY PRECHECK",
        "Đang kiểm tra inventory của cả hai acc"
    )

    if not orangePrecheckInventoriesBeforeSeat(seatIndex) then
        warn("[Orange Belt] Inventory precheck chưa hoàn tất, sẽ retry.")
        orangeSessionActive = false
        return false
    end

    -- Chỉ khi server đã trả plan trade ổn định thì cả hai mới vào ghế.
    if not orangeGoSeat(seatIndex) then
        orangeSessionActive = false
        return false
    end

    if orangeWaitTrade() then
        return orangeFinishAndClaim()
    end

    orangeRelease()
    orangeSessionActive = false
    return false
end

local function runOrangeBelt()
    setCurrentBeltPhase("ORANGE BELT")

    if hasBelt("Orange Belt") then
        return true
    end
    if orangeSessionActive or orangeTeleporting then
        return false
    end

    orangeSessionActive = true
    local registered = orangeRegister("orange_start")
    if not registered or not registered.success then
        orangeSessionActive = false
        task.wait(3)
        return false
    end

    -- Phục hồi session cũ sau crash hoặc sau TeleportToPlaceInstance.
    local oldState = orangeCheck()
    if oldState and oldState.player and oldState.player.session_id then
        return orangeResumeSession(oldState)
    end

    -- Ghép cặp nguyên tử trên server. Hai acc gọi đồng thời vẫn chỉ tạo 1 session:
    -- acc đầu là requester, acc sau là helper.
    local matched = orangeMatchRequest()

    if matched and matched.hop_required == true then
        local currentServer = matched.current_server or {}
        warn(
            "[Orange Belt] Server full | JobId:",
            tostring(currentServer.job_id or game.JobId),
            "| free pairs:",
            #(currentServer.free_pair_slots or {}),
            "| free seats:",
            #(currentServer.free_seats or {})
        )

        orangeSessionActive = false
        getgenv().OrangeHopLowestServer()
        return false
    end

    if not matched or not matched.success then
        orangeSessionActive = false
        task.wait(3)
        return false
    end

    local assigned = matched.assigned or {}
    local serverInfo = matched.server or {}

    warn(
        "[Orange Belt] ASSIGNED | role:",
        tostring(assigned.role or matched.role),
        "| JobId:",
        tostring(assigned.job_id or (
            matched.session and matched.session.job_id
        )),
        "| pair:",
        tostring(assigned.pair_slot or (
            matched.session and matched.session.pair_slot
        )),
        "| no-seat:",
        tostring(assigned.seat_index or matched.seat_index),
        "| free pairs:",
        #(serverInfo.free_pair_slots or {}),
        "| free seats:",
        #(serverInfo.free_seats or {})
    )

    if matched.role == "helper" then
        orangeSetStatus(
            "ORANGE BELT • HELPER",
            "Đã ghép helper, đang lấy JobId requester"
        )

        local freshState = orangeCheck()
        local freshJoin = freshState and freshState.join
        local targetJobId = tostring(
            (freshJoin and freshJoin.job_id)
            or (matched.join and matched.join.job_id)
            or (matched.session and matched.session.job_id)
            or ""
        )
        local targetPlaceId =
            (freshJoin and freshJoin.place_id)
            or (matched.join and matched.join.place_id)
            or (matched.session and matched.session.place_id)

        if targetJobId ~= "" and game.JobId ~= targetJobId then
            orangeJoinJob(targetPlaceId, targetJobId)
            return false
        end

        return orangeResumeSession(freshState or matched)
    end

    orangeSetStatus(
        "ORANGE BELT • REQUESTER",
        "Đã vào queue, đang chờ helper"
    )

    return orangeResumeSession(orangeCheck() or matched)
end

