local function orangeAcceptUntilTradeEnds(timeout)
    local started = tick()
    local lastAcceptAt = 0
    local guiWasOpen = orangeTradeGuiIsOpen()

    while tick() - started < (tonumber(timeout) or 90) do
        if orangeTradeCompletionVisible() then
            orangeTradeCompletedSignal = true
            return true
        end

        local guiOpen = orangeTradeGuiIsOpen()

        if guiOpen then
            guiWasOpen = true

            -- Accept được gọi lặp lại. Một acc Ready trước sẽ tiếp tục giữ
            -- trạng thái, còn acc kia sẽ tự accept lại nếu lần đầu bị miss.
            if tick() - lastAcceptAt >= 0.9 then
                lastAcceptAt = tick()

                local ok, result = pcall(function()
                    return OrangeTradeFunction:InvokeServer("accept")
                end)

                warn(
                    "[AUTO TRADE] accept loop:",
                    ok,
                    result,
                    "| ready labels:",
                    orangeCountReadyLabels()
                )
            end
        elseif guiWasOpen then
            -- GUI vừa đóng. Chờ ngắn để thông báo completion xuất hiện.
            local closedAt = tick()

            while tick() - closedAt < 4 do
                if orangeTradeCompletionVisible() then
                    orangeTradeCompletedSignal = true
                    return true
                end
                task.wait(0.15)
            end

            -- Có thể trade vừa hoàn tất nhưng thông báo không còn trên GUI.
            -- Trả về để outer loop kiểm tra quest/server thay vì add lại ngay.
            return true
        end

        task.wait(0.15)
    end

    return false
end

local function orangeRunAutoTrade()
    if orangeAutoTradeRunning or orangeAutoTradeFinished then return end
    orangeAutoTradeRunning = true
    warn("[AUTO TRADE] COORDINATOR START")

    local openStarted = tick()
    local lastOpenReseatAt = 0

    while not orangeTradeGuiIsOpen()
        and tick() - openStarted < ORANGE_TRADE_OPEN_TIMEOUT do

        if tick() - lastOpenReseatAt >= 2 then
            lastOpenReseatAt = tick()

            local checkData = orangeCheck()
            local currentPlayer = checkData and checkData.player
            local currentSeat = currentPlayer and tonumber(currentPlayer.seat_index)
            local _, hum = getCharacter()

            if currentSeat and not hum.Sit then
                warn(
                    "[AUTO TRADE] GUI chưa mở, ép ngồi lại điểm drop:",
                    currentSeat
                )
                orangeAutoTradeRunning = false
                orangeReturnToAssignedSeat(currentSeat)
                return
            end
        end

        task.wait(0.25)
    end

    if not orangeTradeGuiIsOpen() then
        warn("[AUTO TRADE] Trade GUI chưa mở.")
        orangeAutoTradeRunning = false
        return
    end

    local snapshot = orangeInventorySnapshot()
    local submitted = orangePostTradeInventory(snapshot)
    if not submitted then
        warn("[AUTO TRADE] Không gửi được inventory lên server.")
        orangeAutoTradeRunning = false
        return
    end

    local started = tick()
    local lastPartnerReseatAt = 0

    while tick() - started < ORANGE_TRADE_PLAN_TIMEOUT do
        local response = orangeGetTradePlan()

        if response
            and response.success == false
            and tostring(response.error or "") == "session_not_found" then
            orangeRecoverMissingSession("trade_coordinator")
            orangeAutoTradeRunning = false
            return
        end

        local plan = response and response.plan
        local action = plan and tostring(plan.action or "") or ""

        if action == "remove_duplicate" then
            -- Cả hai acc đều rời bàn. Acc chờ không được ngồi lại sớm,
            -- nếu không cửa sổ trade mở lại và LoadFruit bị chặn.
            orangeEnterDuplicateWaitPhase(plan)

            local targetUsername = string.lower(tostring(plan.username or ""))
            local myUsername = string.lower(tostring(plr.Name or ""))

            if targetUsername == myUsername then
                local requestedFruit = orangeNormalizeFruitName(
                    plan.fruit and (
                        plan.fruit.internal_name
                        or plan.fruit.name
                    )
                )
                local previousFruit = orangeNormalizeFruitName(
                    orangeDuplicateCycleFruit or ""
                )

                if requestedFruit ~= ""
                    and requestedFruit ~= previousFruit then
                    orangeDuplicateCycleCompleted = false
                    orangeDuplicateResetKey = nil
                end

                if orangeDuplicateCycleCompleted then
                    if getgenv().DracoFlowUI then
                        getgenv().DracoFlowUI:SetStatus("WAIT INVENTORY RECHECK")
                        getgenv().DracoFlowUI:SetSubStatus(
                            "Đã xử lý " .. tostring(requestedFruit)
                            .. ", đang chờ server kiểm tra lại"
                        )
                    end
                    orangePostTradeInventory(orangeInventorySnapshot())
                    task.wait(0.5)
                else
                    if getgenv().DracoFlowUI then
                        getgenv().DracoFlowUI:SetStatus("REMOVE DUPLICATE")
                        getgenv().DracoFlowUI:SetSubStatus(
                            "Không có plan trade; đang xóa fruit trùng: "
                            .. tostring(plan.fruit and plan.fruit.name or "?")
                        )
                    end

                    local removed = orangeLoadAndResetDuplicate(plan.fruit)
                    if not removed then
                        warn("[AUTO TRADE] Xóa fruit trùng thất bại; chờ retry.")
                    end
                    task.wait(0.8)
                end
            end

            if getgenv().DracoFlowUI then
                getgenv().DracoFlowUI:SetStatus("WAIT DUPLICATE RESET")
                getgenv().DracoFlowUI:SetSubStatus(
                    "Đứng ngoài điểm drop, chờ acc kia xóa: "
                    .. tostring(plan.fruit and plan.fruit.name or "?")
                )
            end

        elseif action == "trade" then
            -- Server đã có inventory mới và trade plan mới.
            -- Mở khóa cycle mới; cycle trước chỉ xóa đúng 1 fruit.
            orangeDuplicateCycleCompleted = false
            orangeDuplicateCycleFruit = nil
            -- Hai acc quay lại điểm drop ngay trong cùng flow.
            -- Không return giữa chừng vì acc chờ có thể đứng im mãi.
            if orangeDuplicatePhaseOffSeat then
                if not orangeExitDuplicateWaitPhase() then
                    warn("[AUTO TRADE] Không quay lại được điểm drop sau duplicate phase.")
                    orangeAutoTradeRunning = false
                    return
                end
            end

            -- Nếu GUI chưa mở, ép ngồi lại và tiếp tục chờ ngay tại đây.
            if not orangeTradeGuiIsOpen() then
                local current = orangeCheck()
                local currentPlayer = current and current.player
                local currentSeat = currentPlayer and currentPlayer.seat_index

                if currentSeat then
                    if not orangeReturnToAssignedSeat(currentSeat) then
                        orangeAutoTradeRunning = false
                        return
                    end
                end

                local guiStarted = tick()
                while not orangeTradeGuiIsOpen()
                    and tick() - guiStarted < 15 do
                    task.wait(0.25)
                end

                if not orangeTradeGuiIsOpen() then
                    warn("[AUTO TRADE] Đã về điểm drop nhưng trade GUI chưa mở.")
                    orangeAutoTradeRunning = false
                    return
                end
            end

            local items = plan.items and plan.items[plr.Name]
            local myValue = plan.values and plan.values[plr.Name] or 0
            local mySlots = plan.slot_counts and plan.slot_counts[plr.Name] or 0
            warn(
                "[AUTO TRADE] Trade plan ready | value:",
                myValue,
                "| slots:",
                mySlots,
                "| difference:",
                tostring(plan.difference_percent or "?") .. "%"
            )
            if orangeAddPlannedItems(items) then
                task.wait(0.5)

                -- Không đánh dấu finished sau lần accept đầu tiên.
                -- Loop accept cho tới khi cả hai bên Ready và trade đóng/xong.
                local ended = orangeAcceptUntilTradeEnds(90)

                orangeAutoTradeFinished = false
                orangeAutoTradeRunning = false

                if ended then
                    return
                end
            end

            -- Add thất bại hoặc accept loop timeout:
            -- loop lại ghế và chạy coordinator lại.
            orangeAutoTradeFinished = false
            orangeAutoTradeRunning = false

            local current = orangeCheck()
            local currentPlayer = current and current.player
            local currentSeat = currentPlayer and tonumber(currentPlayer.seat_index)

            if currentSeat then
                orangeReturnToAssignedSeat(currentSeat)
            end

            return

        elseif action == "waiting_inventory" then
            if getgenv().DracoFlowUI then
                getgenv().DracoFlowUI:SetStatus("CHECK BOTH INVENTORIES")
                getgenv().DracoFlowUI:SetSubStatus(
                    "Đang chờ inventory mới sau khi reset fruit"
                )
            end

        elseif action == "no_balanced_pair" then
            orangeDuplicateCycleCompleted = false
            orangeDuplicateCycleFruit = nil
            if orangeDuplicatePhaseOffSeat then
                orangeAutoTradeRunning = false
                orangeExitDuplicateWaitPhase()
                return
            end

            warn("[AUTO TRADE] Không tìm thấy cặp fruit cân value.")
            orangeAutoTradeRunning = false
            return
        end

        task.wait(0.8)
    end

    warn("[AUTO TRADE] Hết thời gian chờ trade plan.")
    orangeAutoTradeRunning = false
end

local function screenHasTradeCompleted()
    local pg = plr:FindFirstChild("PlayerGui")
    if not pg then
